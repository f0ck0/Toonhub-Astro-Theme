---
import "../styles/global.css"
import CartDrawer from "../components/CartDrawer.astro"
import SearchOverlay from "../components/SearchOverlay.astro"
import QuickView from "../components/QuickView.astro"
import { SITE } from "../lib/site"
import { medusaConfig } from "../lib/medusa-config"

const {
  title = `${SITE.name}: Shop Premium Anime Figures`,
  description = SITE.description,
} = Astro.props
const medusa = medusaConfig()
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body>
  <a class="skip-link" href="#MainContent">Skip to content</a>
  <slot />
  <CartDrawer />
  <SearchOverlay />
  <QuickView />
  <script is:inline define:vars={{ baseUrl: medusa.baseUrl, publishableKey: medusa.publishableKey }}>
    window.toonhubMedusa = { baseUrl: baseUrl, publishableKey: publishableKey }
  </script>
  <script>
    import "../scripts/storefront"
    import "../scripts/catalog"
  </script>
</body>
</html>
