<div id="searchModal" class="search-modal" role="dialog" aria-label="Search">
  <form id="searchForm" class="search-bar" action="/search" method="get">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input id="searchInput" type="search" name="q" placeholder="Search anime figures…" autocomplete="off" />
    <button class="close-x" type="button" data-close-search aria-label="Close search">×</button>
  </form>
  <div id="searchResults" class="search-results">
    <p style="padding:24px 20px;color:#888;font-size:0.9rem;">Type to search figures, series and more.</p>
  </div>
</div>
