---
const { kind, label } = Astro.props
---
<div class="jdgm-medal" data-medal={kind}>
  <div class="jdgm-medal-art" data-medal-art>
    <svg viewBox="0 0 90 108" aria-hidden="true">
      <path fill="#B5C771" d="M45 3.2 54.4 16.8 45 21.4 35.6 16.8Z"/>
      <path fill="#0b0b0b" fill-opacity=".22" d="M45 6.4 51.2 15.8 45 18.6 38.8 15.8Z"/>
      <path fill="none" stroke="#B5C771" stroke-width="1.35" stroke-linecap="round" d="M31 26c-11 11-13.2 30-5 48M59 26c11 11 13.2 30 5 48"/>
      <g fill="#B5C771">
        <ellipse cx="30" cy="30" rx="3.35" ry="6.15" transform="rotate(-38 30 30)"/>
        <ellipse cx="23.6" cy="40.2" rx="3.25" ry="6.05" transform="rotate(-22 23.6 40.2)"/>
        <ellipse cx="21.2" cy="51.6" rx="3.2" ry="5.95" transform="rotate(-6 21.2 51.6)"/>
        <ellipse cx="23.2" cy="63.2" rx="3.15" ry="5.75" transform="rotate(14 23.2 63.2)"/>
        <ellipse cx="28.8" cy="73.2" rx="3.05" ry="5.55" transform="rotate(32 28.8 73.2)"/>
        <ellipse cx="60" cy="30" rx="3.35" ry="6.15" transform="rotate(38 60 30)"/>
        <ellipse cx="66.4" cy="40.2" rx="3.25" ry="6.05" transform="rotate(22 66.4 40.2)"/>
        <ellipse cx="68.8" cy="51.6" rx="3.2" ry="5.95" transform="rotate(6 68.8 51.6)"/>
        <ellipse cx="66.8" cy="63.2" rx="3.15" ry="5.75" transform="rotate(-14 66.8 63.2)"/>
        <ellipse cx="61.2" cy="73.2" rx="3.05" ry="5.55" transform="rotate(-32 61.2 73.2)"/>
      </g>
      <circle cx="45" cy="54" r="19.6" fill="none" stroke="#B5C771" stroke-width="2.15"/>
      <circle cx="45" cy="54" r="16.1" fill="none" stroke="#B5C771" stroke-width=".7" opacity=".5"/>
      <text data-medal-num x="45" y="59.6" text-anchor="middle" fill="#B5C771" font-family="Georgia, 'Times New Roman', serif" font-size="15" font-weight="700">0</text>
    </svg>
  </div>
  <span>{label}</span>
</div>
