---
/**
 * <TrustIcons /> — reassurance row (shipping, returns, SSL, offer).
 *
 * Pure static markup: no script, no props fetched at runtime. Icons are inline
 * SVG marked `aria-hidden`, and the accompanying text is real text so it is
 * readable by screen readers, translators and search engines.
 */

export interface TrustItem {
  /** Accessible label and visible text. */
  label: string
  /** Path data drawn in a 24×24 box. */
  icon: string
}

export interface Props {
  /** Grid (default) or stacked list. */
  variant?: "grid" | "list"
  /** Include the "2nd figure 50% off" tile. */
  gift?: boolean
  /** Replace the default items entirely. */
  items?: TrustItem[]
  class?: string
}

const DEFAULT_ITEMS: TrustItem[] = [
  {
    label: "Free shipping",
    icon: "M3 7h12v9H3zM15 10h4.2L21 13.2V16h-6M7.2 18.2h.01M17.2 18.2h.01",
  },
  { label: "30-day returns", icon: "M8 5 4 9l4 4M4 9h9a6 6 0 1 1 0 12H8" },
  { label: "SSL encrypted", icon: "M5 11h14v10H5zM8.2 11V8.2a3.8 3.8 0 0 1 7.6 0V11" },
]

const GIFT_ITEM: TrustItem = {
  label: "2nd figure 50% off",
  icon: "M3.5 10h17v10.5h-17zM3.5 10h17M12 10v10.5M12 10c0-3-1.8-5-4-5s-4 1.6-4 5h8Zm0 0c0-3 1.8-5 4-5s4 1.6 4 5h-8Z",
}

const { variant = "grid", gift = false, items, class: className = "" } = Astro.props

const list = (items?.length ? items : [...DEFAULT_ITEMS, ...(gift ? [GIFT_ITEM] : [])]).filter(
  (item) => item?.label,
)
---

{list.length > 0 && (
  <ul class:list={["trust-icons", variant === "list" && "trust-icons--list", gift && "trust-icons--four", className]}>
    {list.map((item) => (
      <li class="trust-icons__item">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={item.icon} />
        </svg>
        <span>{item.label}</span>
      </li>
    ))}
  </ul>
)}

<style>
  .trust-icons {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .trust-icons--four { grid-template-columns: 1fr 1fr; }
  .trust-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #111;
    border: 1px solid #2a2a2a;
    border-radius: 0.3rem;
    padding: 12px 8px;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #ddd;
    line-height: 1.3;
    transition: border-color 200ms ease, background-color 200ms ease;
  }
  .trust-icons__item:hover { border-color: #3a3a3a; background: #151515; }
  .trust-icons svg {
    width: 22px;
    height: 22px;
    stroke: #fff;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
  .trust-icons--list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 18px;
  }
  .trust-icons--list .trust-icons__item {
    flex-direction: row;
    justify-content: flex-start;
    background: transparent;
    border: 0;
    padding: 0;
    text-align: left;
    gap: 10px;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: #bbb;
  }
  .trust-icons--list .trust-icons__item:hover { background: transparent; }
  .trust-icons--list svg { width: 20px; height: 20px; }
  @media (max-width: 600px) {
    .trust-icons:not(.trust-icons--four):not(.trust-icons--list) { grid-template-columns: 1fr; }
  }
</style>
