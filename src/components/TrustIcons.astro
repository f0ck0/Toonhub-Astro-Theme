---
const { gift = false } = Astro.props as { gift?: boolean }
---
<div class:list={["trust-icons", gift && "four"]}>
  <span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 7h12v9H3z"></path>
      <path d="M15 10h4.2L21 13.2V16h-6"></path>
      <circle cx="7.2" cy="18.2" r="1.6"></circle>
      <circle cx="17.2" cy="18.2" r="1.6"></circle>
    </svg>
    Free shipping
  </span>
  <span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5 4 9l4 4"></path>
      <path d="M4 9h9a6 6 0 1 1 0 12H8"></path>
    </svg>
    30-day returns
  </span>
  <span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="5" y="11" width="14" height="10" rx="1.6"></rect>
      <path d="M8.2 11V8.2a3.8 3.8 0 0 1 7.6 0V11"></path>
    </svg>
    SSL encrypted
  </span>
  {gift && (
    <span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="10" width="17" height="10.5" rx="1"></rect>
        <path d="M3.5 10h17M12 10v10.5"></path>
        <path d="M12 10c0-3-1.8-5-4-5s-4 1.6-4 5h8Z"></path>
        <path d="M12 10c0-3 1.8-5 4-5s4 1.6 4 5h-8Z"></path>
      </svg>
      2nd figure 50% off
    </span>
  )}
</div>

<style>
  .trust-icons {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    margin-top: 14px;
  }
  .trust-icons.four { grid-template-columns: 1fr 1fr; }
  .trust-icons span {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #111;
    border: 1px solid #2a2a2a;
    border-radius: 0.3rem;
    padding: 12px 8px;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #ddd;
    line-height: 1.3;
  }
  .trust-icons svg {
    width: 22px;
    height: 22px;
    stroke: #fff;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 600px) {
    .trust-icons:not(.four) { grid-template-columns: 1fr; }
  }
</style>
