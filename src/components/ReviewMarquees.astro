---
/**
 * <ReviewMarquees /> — two stacked, infinitely scrolling review rows for the
 * homepage ("new-arrival anime figures · what collectors say").
 *
 * - Top row moves left→right, bottom row right→left, hover/focus pauses both.
 * - Items are interleaved across the rows so photo-heavy and text-heavy
 *   reviews distribute evenly. Each row's track is duplicated for a seamless
 *   CSS loop (the copy is `aria-hidden`, so screen readers hear it once).
 * - Real data only: when Medusa has no reviews, the whole section is skipped.
 * - `prefers-reduced-motion` turns the animation off (rows stay scrollable).
 */
import type { NormalizedReview, Product } from "../types"
import { pageLocale, useTranslations, type Locale } from "../lib/i18n"

export interface ReviewCardItem {
  review: NormalizedReview
  product?: Product | null
}

export interface Props {
  items: ReviewCardItem[]
  /** Section heading (defaults to the dictionary key). */
  title?: string
  class?: string
}

const { items, title, class: className = "" } = Astro.props

const locale: Locale = pageLocale(Astro)
const t = useTranslations(locale)

/** First half of one row (items are interleaved by the caller). */
const rows: [ReviewCardItem[], ReviewCardItem[]] = [[], []]
items.forEach((item, index) => rows[index % 2 === 0 ? 0 : 1].push(item))

const starPath = "M12 2.4 14.9 8.3l6.5.9-4.7 4.6 1.1 6.5L12 17.2 6.2 20.3l1.1-6.5L2.6 9.2l6.5-.9L12 2.4z"

/** Rating stars as a clipped-fill overlay — exact, no trailing half-stars. */
function starsOf(rating: number): number {
  const clamped = Math.max(0, Math.min(5, Number(rating) || 0))
  return (clamped / 5) * 100
}

function productHandleOf(item: ReviewCardItem): string {
  return String(item.product?.handle || "")
}

function photosOf(item: ReviewCardItem): string[] {
  const photos = (item.review.images || []).filter(Boolean).slice(0, 3)
  if (photos.length) return photos
  const fallback = String(item.product?.thumbnail || "")
  return fallback ? [fallback] : []
}

const productTitleOf = (item: ReviewCardItem): string => String(item.product?.title || "")
const half = Array.from({ length: 5 })
---

{items.length > 0 && (
  <section class:list={["review-marquees", className]} aria-labelledby="reviewMarqueesHeading">
    <div class="review-marquees__head">
      {/*
        `under-heading` sits directly beneath the title text — the homepage
        passes the store-wide rating strip (<ReviewMedals />) here so the
        average and the individual reviews read as one block.
      */}
      <div class="review-marquees__headline">
        <h2 id="reviewMarqueesHeading" class="review-marquees__heading">
          {title || t("home.reviewsMarqueeTitle")}
        </h2>
        <slot name="under-heading" />
      </div>
      <p class="review-marquees__sub">{t("home.reviewsMarqueeSub", { count: items.length })}</p>
    </div>

    {rows.map((row, rowIndex) => (
      row.length > 0 && (
        <div
          class:list={["review-marquee", rowIndex === 0 && "review-marquee--ltr"]}
          style={`--marquee-duration: ${Math.min(90, 28 + row.length * 7)}s;`}
        >
          <div class="review-marquee__track">
            {[0, 1].map((copy) => (
              <div class="review-marquee__lane" aria-hidden={copy === 1 ? "true" : undefined}>
                {row.map((item) => {
                  const handle = productHandleOf(item)
                  const photos = photosOf(item)
                  const rating = Math.max(0, Math.min(5, Number(item.review.rating) || 0))
                  const text = String(item.review.content || item.review.title || "").trim()
                  const inner = (
                    <>
                      {photos.length > 0 && (
                        <div class:list={["review-card__photos", photos.length === 1 && "is-single"]}>
                          {photos.map((url) => (
                            <img src={url} alt="" width="104" height="104" loading="lazy" decoding="async" />
                          ))}
                        </div>
                      )}
                      <div class="review-card__stars" aria-label={`${rating}/5`}>
                        <span class="review-card__stars-track">
                          {half.map(() => (
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={starPath} /></svg>
                          ))}
                          <span class="review-card__stars-fill" style={`width:${starsOf(item.review.rating)}%;`}>
                            {half.map(() => (
                              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={starPath} /></svg>
                            ))}
                          </span>
                        </span>
                      </div>
                      {text && <p class="review-card__text">{text}</p>}
                      <p class="review-card__meta">
                        <b>{item.review.name}</b>
                        {productTitleOf(item) && <span class="review-card__product">{productTitleOf(item)}</span>}
                      </p>
                    </>
                  )
                  return handle ? (
                    <a
                      class="review-card"
                      href={`/products/${encodeURIComponent(handle)}`}
                      aria-label={t("home.reviewOnProduct", { name: item.review.name, product: productTitleOf(item) })}
                    >
                      {inner}
                    </a>
                  ) : (
                    <article class="review-card">{inner}</article>
                  )
                })}
              </div>
            ))}
          </div>
        </div>
      )
    ))}
  </section>
)}

<style>
  .review-marquees { padding: 8px 0 24px; }
  .review-marquees__head {
    max-width: var(--page-width, 1200px);
    margin: 0 auto 18px;
    padding: 0 16px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .review-marquees__headline { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .review-marquees__heading { font-size: 1.05rem; letter-spacing: 0.02em; }
  .review-marquees__sub { font-size: 0.8rem; color: var(--text-muted, #9a9a9a); }
  /*
   * The slotted rating strip is a full-width centred band on its own (it is
   * also used standalone under the hero); inside this heading block it should
   * hug the title instead.
   */
  .review-marquees__headline :global(.trust-strip) {
    justify-content: flex-start;
    padding: 0;
    background: transparent;
  }

  .review-marquee {
    overflow: hidden;
    /* Soft fade at both edges keeps the loop feeling endless. */
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    padding: 6px 0;
  }
  .review-marquee__track { display: flex; width: max-content; }
  .review-marquee__lane { display: flex; gap: 14px; padding-right: 14px; }

  /* Right-to-left drift (bottom row). */
  .review-marquee__track { animation: review-marquee-rtl var(--marquee-duration, 48s) linear infinite; }
  /* Top row runs left-to-right: same keyframes, played backwards. */
  .review-marquee--ltr .review-marquee__track { animation-direction: reverse; }

  @keyframes review-marquee-rtl {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .review-marquee:hover .review-marquee__track,
  .review-marquee:focus-within .review-marquee__track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .review-marquee__track { animation: none; }
    .review-marquee { overflow-x: auto; }
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 320px;
    max-width: 78vw;
    box-sizing: border-box;
    padding: 14px;
    border: 1px solid var(--color-border, #2a2a2a);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.02);
    color: inherit;
    text-decoration: none;
  }
  a.review-card:hover { border-color: #B5C771; }
  .review-card__photos { display: flex; gap: 8px; }
  .review-card__photos img {
    width: 104px;
    height: 104px;
    border-radius: 3px;
    object-fit: cover;
    background: #161616;
  }
  .review-card__photos:not(.is-single) img { flex: 1 1 0; min-width: 0; }
  .review-card__photos.is-single img { width: 104px; }
  .review-card__stars-track {
    position: relative;
    display: inline-flex;
    gap: 1.5px;
  }
  .review-card__stars-track svg { width: 13px; height: 13px; fill: #454545; }
  .review-card__stars-fill {
    position: absolute;
    inset: 0 auto 0 0;
    overflow: hidden;
    display: inline-flex;
    gap: 1.5px;
    white-space: nowrap;
  }
  .review-card__stars-fill svg { width: 13px; height: 13px; fill: var(--color-accent, #B5C771); flex: none; }
  .review-card__text {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #dcdcdc;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .review-card__meta {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.75rem;
    color: var(--text-muted, #9a9a9a);
  }
  .review-card__meta b { color: #efefef; font-size: 0.8rem; }
  .review-card__product { color: var(--text-faint, #787878); }
</style>
