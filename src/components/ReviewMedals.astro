---
/**
 * <ReviewMedals /> — homepage trust strip.
 *
 * Hidden until there is real data: `reviews.ts` fills the star width and the
 * count from Medusa, and unhides the strip only when both exist. Passing
 * `count`/`rating` renders the final state server-side (no layout shift, no
 * flash of an empty band).
 */

export interface Props {
  /** Known store-wide review count. 0 keeps the strip hidden until hydration. */
  count?: number
  /** Known store-wide average (0–5). */
  rating?: number
  /** Star track size in px. */
  size?: number
  /** Extra classes. */
  class?: string
}

const { count = 0, rating = 0, size = 20, class: className = "" } = Astro.props

const total = Math.max(0, Number(count) || 0)
const value = Math.min(5, Math.max(0, Number(rating) || 0))
const filled = total > 0 && value > 0
const fillPercent = filled ? Math.max(0, Math.min(100, (value / 5) * 100)) : 0
const starPath =
  "M12 2.4 14.9 8.3l6.5.9-4.7 4.6 1.1 6.5L12 17.2 6.2 20.3l1.1-6.5L2.6 9.2l6.5-.9L12 2.4z"
---

<div
  class:list={["trust-strip", className]}
  data-hydrate-reviews
  hidden={!filled}
  aria-label={
    filled ? `Rated ${value.toFixed(1)} out of 5 from ${total} reviews` : undefined
  }
>
  <p class="jdgm-rating">
    <span class="jdgm-stars" data-review-stars style={`--star-size:${size}px;`}>
      <span class="jdgm-stars-track">
        {Array.from({ length: 5 }).map(() => (
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={starPath} /></svg>
        ))}
        <span class="jdgm-stars-fill" data-review-fill style={`width:${fillPercent}%`}>
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={starPath} /></svg>
          ))}
        </span>
      </span>
    </span>
    <span class="jdgm-count" data-review-count>
      {filled ? `${total.toLocaleString()} review${total === 1 ? "" : "s"} · ${value.toFixed(1)}★` : ""}
    </span>
  </p>
</div>
