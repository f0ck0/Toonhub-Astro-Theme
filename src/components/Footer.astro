---
/**
 * <Footer /> — newsletter band + site map links + locale switcher.
 *
 * Static server-rendered markup. Its only script is the newsletter submit
 * handler, scoped to this component so it ships wherever the footer renders and
 * nowhere else. All user-facing copy arrives through `data-*` attributes so the
 * script stays language-agnostic.
 */
import { SITE } from "../lib/site"
import { CURRENCY_OPTIONS, currencyFromCookies, currencyLabel } from "../lib/currency"
import { localeLabel, locales, pageLocale, useTranslations, type Locale } from "../lib/i18n"
import type { NavLink } from "../types"

export interface Props {
  /** BCP-47 locale for UI strings. */
  lang?: string
  /** Override any of the three link columns. */
  shopLinks?: NavLink[]
  helpLinks?: NavLink[]
  policyLinks?: NavLink[]
  /** Hide the newsletter band (e.g. on checkout). */
  newsletter?: boolean
  /** Extra payment labels. */
  payments?: readonly string[]
  class?: string
}

const {
  lang,
  shopLinks = [
    { label: "Shop All", href: "/collections" },
    { label: "New Designs", href: "/collections/new-arrivals" },
    { label: "Search", href: "/search" },
    { label: "Wishlist", href: "/wishlist" },
    { label: "Blog", href: "/blog" },
  ],
  helpLinks = [
    { label: "Track Order", href: "/track-order" },
    { label: "About Us", href: "/about" },
    { label: "Contact Us", href: "/contact" },
    { label: "Figure Care Guide", href: "/care-guide" },
    { label: "Affiliate Program", href: "/affiliate" },
  ],
  policyLinks = [
    { label: "Refund Policy", href: "/policies/refund-policy" },
    { label: "Shipping Policy", href: "/policies/shipping-policy" },
    { label: "Terms of Service", href: "/policies/terms-of-service" },
    { label: "Privacy Policy", href: "/policies/privacy-policy" },
    { label: "Cancellation Policy", href: "/policies/cancellation-policy" },
  ],
  newsletter = true,
  payments = ["Visa", "Mastercard", "Amex", "PayPal", "Apple Pay", "Google Pay"],
  class: className = "",
} = Astro.props

const locale: Locale = pageLocale(Astro, lang)
const t = useTranslations(locale)
const currency = currencyFromCookies(Astro.cookies)
const year = new Date().getFullYear()
/** Where the language switcher returns to after `/api/locale` sets the cookie. */
const returnTo = `${Astro.url.pathname}${Astro.url.search}`

const columns: { heading: string; links: NavLink[] }[] = [
  { heading: t("footer.shop"), links: shopLinks },
  { heading: t("footer.help"), links: helpLinks },
  { heading: t("footer.policies"), links: policyLinks },
]

const social = [
  { label: "Instagram", href: SITE.instagram, icon: "instagram" },
  { label: "TikTok", href: SITE.tiktok, icon: "tiktok" },
].filter((item) => /^https?:\/\//.test(item.href))
---

{newsletter && (
  <section class="footer-newsletter" aria-labelledby="newsletterHeading">
    <h2 id="newsletterHeading">{t("newsletter.heading")}</h2>
    <p>{t("newsletter.body")}</p>

    <form
      class="newsletter-form"
      data-newsletter-form
      novalidate
      data-messages={JSON.stringify({
        success: t("newsletter.success"),
        invalid: t("newsletter.invalid"),
        error: t("newsletter.error"),
        network: t("newsletter.networkError"),
      })}
    >
      <label class="sr-only" for="newsletterEmail">{t("newsletter.placeholder")}</label>
      <input
        id="newsletterEmail"
        class="newsletter-form__input"
        type="email"
        name="email"
        required
        inputmode="email"
        autocomplete="email"
        placeholder={t("newsletter.placeholder")}
        aria-describedby="newsletterMsg"
      />
      <button class="newsletter-form__submit" type="submit" data-newsletter-submit aria-label={t("newsletter.submit")}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </button>
    </form>

    <p id="newsletterMsg" class="form-message" role="status" aria-live="polite" hidden></p>

    {social.length > 0 && (
      <ul class="footer-social">
        {social.map((item) => (
          <li>
            <a
              href={item.href}
              aria-label={item.label}
              rel="me noopener noreferrer"
              target="_blank"
              class="footer-social__link"
            >
              {item.icon === "instagram" ? (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                </svg>
              ) : (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                  <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
)}

<footer class:list={["site-footer", className]} lang={locale}>
  <div class="page-width">
    <div class="footer-menus">
      {columns.map((column) => (
        <nav aria-label={column.heading}>
          <h2 class="footer-heading">{column.heading}</h2>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom">
      <div class="footer-locale currency-wrap">
        <button
          id="footerCurrencyBtn"
          class="footer-locale-btn"
          type="button"
          data-currency-toggle="footerCurrencyMenu"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="footerCurrencyMenu"
          aria-label={`${t("a11y.currency")}: ${currencyLabel(currency)}`}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span>{currencyLabel(currency)}</span>
        </button>
        <div id="footerCurrencyMenu" class="currency-menu" role="listbox" data-currency-menu aria-label={t("a11y.currency")}>
          <p class="currency-menu__hint">{t("a11y.currency")}</p>
          {CURRENCY_OPTIONS.map((option) => (
            <button
              type="button"
              class="currency-option"
              role="option"
              data-currency={option.code}
              aria-selected={option.code === currency ? "true" : "false"}
            >
              <span aria-hidden="true">{option.flag}</span> {option.label}
            </button>
          ))}
        </div>
      </div>

      <nav class="footer-lang" aria-label={t("a11y.language")}>
        <svg class="footer-lang__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path d="m5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6" />
        </svg>
        {locales.map((code) => (
          <a
            class="footer-lang__link"
            href={`/api/locale?set=${code}&next=${encodeURIComponent(returnTo)}`}
            lang={code}
            aria-current={code === locale ? "true" : undefined}
          >
            {localeLabel(code)}
          </a>
        ))}
      </nav>

      <ul class="pay-row" aria-label={t("footer.paymentMethods")}>
        {payments.map((method) => <li><span>{method}</span></li>)}
      </ul>

      <p class="footer-copy">{t("footer.rights", { year, brand: SITE.name })}</p>
    </div>
  </div>
</footer>

<script>
  import { config } from "../scripts/lib/config"

  /**
   * Newsletter: try Medusa first (three possible endpoint shapes across
   * versions), then our own `/api/newsletter` route which persists locally when
   * the backend has no subscriber route. Copy comes from the server-rendered
   * `data-messages` attribute, so this script contains no user-facing strings.
   */
  const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]")

  if (form) {
    const submit = form.querySelector<HTMLButtonElement>("[data-newsletter-submit]")
    const message = document.getElementById("newsletterMsg")
    const messages = JSON.parse(form.dataset.messages || "{}") as Record<string, string>

    const show = (tone: "success" | "error", text: string) => {
      if (!message) return
      message.hidden = false
      message.dataset.tone = tone
      message.textContent = text
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      const input = form.querySelector<HTMLInputElement>('input[name="email"]')
      const email = input?.value.trim() || ""
      const valid = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)

      if (!valid) {
        show("error", messages.invalid || "Please enter a valid email.")
        input?.focus()
        return
      }

      if (submit) {
        submit.disabled = true
        submit.setAttribute("aria-busy", "true")
      }

      try {
        const { baseUrl, publishableKey } = config()
        if (baseUrl) {
          const paths = ["/store/newsletter-subscribers", "/store/subscribers", "/store/newsletter"]
          for (const path of paths) {
            try {
              const res = await fetch(`${baseUrl}${path}`, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  accept: "application/json",
                  ...(publishableKey ? { "x-publishable-api-key": publishableKey } : {}),
                },
                body: JSON.stringify({ email }),
                signal: AbortSignal.timeout(6000),
              })
              if (res.ok || res.status === 409) {
                show("success", messages.success || "Thanks — you're on the list.")
                form.reset()
                return
              }
            } catch {
              /* try the next shape */
            }
          }
        }

        const res = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
          signal: AbortSignal.timeout(8000),
        })
        const data = (await res.json().catch(() => ({}))) as { error?: string }
        if (res.ok) {
          show("success", messages.success || "Thanks — you're on the list.")
          form.reset()
        } else {
          show("error", data.error || messages.error || "Could not subscribe. Try again.")
        }
      } catch {
        show("error", messages.network || "Network error. Please try again.")
      } finally {
        if (submit) {
          submit.disabled = false
          submit.removeAttribute("aria-busy")
        }
      }
    })
  }
</script>
