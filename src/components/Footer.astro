---
import { SITE } from "../lib/site"
---
<footer style="background:#000;color:#fff;margin-top:80px;border-top:1px solid var(--color-border);">
  <div class="page-width" style="padding:56px 0 0;">
    <div class="footer-grid">
      <div>
        <h3 style="font-size:1.05rem;letter-spacing:0.08em;">Subscribe to our emails</h3>
        <p style="margin-top:10px;font-size:14px;color:#888;max-width:340px;">Subscribe to our mailing list for insider news, product launches, and more.</p>
        <form id="newsletterForm" style="display:flex;gap:8px;margin-top:16px;">
          <input class="field" type="email" name="email" required placeholder="Email" style="flex:1;" />
          <button class="btn btn-primary" type="submit" style="padding:0.9rem 1.2rem;">Join</button>
        </form>
        <p id="newsletterMsg" class="hidden" style="margin-top:8px;font-size:0.82rem;color:#8bc34a;">Thanks — you're on the list.</p>
        <div style="margin-top:20px;display:flex;gap:14px;">
          <a href={SITE.instagram} aria-label="Instagram" style="color:#fff;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a>
          <a href={SITE.tiktok} aria-label="TikTok" style="color:#fff;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg></a>
        </div>
      </div>
      <div>
        <h4 style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#888;margin-bottom:16px;">Shop</h4>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:8px;">
          <li><a href="/collections/all" style="font-size:14px;">Shop All</a></li>
          <li><a href="/collections" style="font-size:14px;">Anime List (A-Z)</a></li>
          <li><a href="/collections/new-arrivals" style="font-size:14px;">New Designs</a></li>
          <li><a href="/search" style="font-size:14px;">Search</a></li>
          <li><a href="/track-order" style="font-size:14px;">Track Order</a></li>
        </ul>
      </div>
      <div>
        <h4 style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#888;margin-bottom:16px;">Help</h4>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:8px;">
          <li><a href="/about" style="font-size:14px;">About Us</a></li>
          <li><a href="/contact" style="font-size:14px;">Contact Us</a></li>
          <li><a href="/care-guide" style="font-size:14px;">Figure Care Guide</a></li>
          <li><a href="/affiliate" style="font-size:14px;">Affiliate Program</a></li>
          <li><a href="/blog" style="font-size:14px;">Blog</a></li>
        </ul>
      </div>
      <div>
        <h4 style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#888;margin-bottom:16px;">Policies</h4>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:8px;">
          <li><a href="/policies/refund-policy" style="font-size:14px;">Refund Policy</a></li>
          <li><a href="/policies/shipping-policy" style="font-size:14px;">Shipping Policy</a></li>
          <li><a href="/policies/terms-of-service" style="font-size:14px;">Terms of Service</a></li>
          <li><a href="/policies/privacy-policy" style="font-size:14px;">Privacy Policy</a></li>
          <li><a href="/policies/cancellation-policy" style="font-size:14px;">Cancellation Policy</a></li>
        </ul>
      </div>
    </div>
    <div style="margin-top:48px;padding:20px 0;border-top:1px solid var(--color-border);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:12px;color:#888;">
      <span>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</span>
      <div class="pay-row" style="margin:0;">
        <span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>PAYPAL</span><span>APPLE PAY</span><span>GOOGLE PAY</span>
      </div>
    </div>
  </div>
</footer>
<script>
  const form = document.getElementById("newsletterForm") as HTMLFormElement | null
  form?.addEventListener("submit", async (e) => {
    e.preventDefault()
    const email = (form.querySelector('[name="email"]') as HTMLInputElement)?.value
    try {
      await fetch("/api/newsletter", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email }) })
    } catch {}
    document.getElementById("newsletterMsg")?.classList.remove("hidden")
    form.reset()
  })
</script>
