---
import { getProductImage, getProductUsdPrice, productImageUrl } from "../lib/medusa"
import { salePrice, formatPriceFrom, formatCurrency, currencyFromCookies } from "../lib/currency"
import { productReviews } from "../lib/site"
import Stars from "./Stars.astro"

const { product } = Astro.props
const img = getProductImage(product)
const hoverRaw = (product?.images || []).map((i: any) => i.url || i).find((u: string) => u && u !== img)
const usdPrice = getProductUsdPrice(product) || 0
const currency = currencyFromCookies(Astro.cookies)
const { original, sale } = salePrice(usdPrice, currency)
const priceFrom = formatPriceFrom(sale, currency)
const originalFmt = formatCurrency(original, currency)
const { rating, count } = productReviews(product)
const variants = (product?.variants || []).map((v: any) => ({ id: v.id, title: v.title || v.options?.map((o: any) => o.value).join(" / ") || "Default" }))
const qv = encodeURIComponent(JSON.stringify({
  variantId: variants[0]?.id || "",
  title: product.title,
  thumbnail: productImageUrl(img),
  handle: product.handle,
  unit_price: usdPrice,
  variant_title: variants[0]?.title,
  variants,
}))
const hasOptions = variants.length > 1
const href = `/products/${product.handle}`
---
<article class="product-card card" data-qv={qv} data-price-usd={usdPrice}>
  <div class="pc-media">
    <a href={href} aria-label={product.title} style="position:absolute;inset:0;z-index:1;">
      {img ? (
        <img src={productImageUrl(img)} alt={product.title} loading="lazy" />
      ) : (
        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#111;"><span style="font-size:48px;">📦</span></div>
      )}
      {hoverRaw && <img class="pc-hover" src={productImageUrl(hoverRaw)} alt="" loading="lazy" />}
    </a>
    <span class="sale-badge">Sale</span>
    <button class="choose-options" type="button" data-action="quickview">
      {hasOptions ? "Choose options" : "Add to cart"}
    </button>
  </div>
  <a href={href} class="pc-info">
    <div class="pc-title">{product.title}</div>
    <Stars rating={rating} count={count} productId={product?.id || ""} />
    <div class="pc-price-row">
      <span class="pc-price product-card-price">{priceFrom}</span>
      <span class="pc-compare" data-price-strike>{originalFmt}</span>
    </div>
  </a>
</article>
