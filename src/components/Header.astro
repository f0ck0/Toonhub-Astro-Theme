---
/**
 * <Header /> — sticky store chrome.
 *
 * Server-rendered and static: the only client code it depends on is the global
 * `ui.ts` module (currency menu, mobile drawer, announcement rotator), which
 * `Base.astro` already loads. No framework, no island, no per-page script.
 *
 * Categories are fetched on the server with a 60 s TTL cache; when Medusa is
 * unreachable the nav still renders (the A–Z dropdown simply hides itself
 * instead of showing an empty panel), and `catalog.ts` can fill it later.
 */
import { getNavCategories } from "../lib/medusa"
import { SITE, groupAz } from "../lib/site"
import { CURRENCY_OPTIONS, currencyFromCookies, currencyLabel } from "../lib/currency"
import { pageLocale, useTranslations, type Locale } from "../lib/i18n"
import type { NavLink, ProductCategory } from "../types"

export interface Props {
  /** BCP-47 locale for the UI strings. Defaults to the negotiated page locale. */
  lang?: string
  /** Categories to render in the A–Z dropdown. Fetched when omitted. */
  categories?: ProductCategory[]
  /** Primary nav links — override to change the menu without editing markup. */
  links?: NavLink[]
  /** Render the mobile menu button. Turn off for embedded/checkout chrome. */
  showMenuButton?: boolean
  /** Compact variant used by the checkout shell. */
  variant?: "default" | "compact"
  /** Announcement messages; pass `[]` to hide the bar. */
  announcements?: readonly string[]
  class?: string
}

const {
  lang,
  categories: categoriesProp,
  links = [
    { label: "", href: "/", match: "exact" },
    { label: "", href: "/track-order", match: "prefix" },
    { label: "", href: "/collections", match: "prefix" },
  ],
  showMenuButton = true,
  variant = "default",
  announcements = SITE.announcements,
  class: className = "",
} = Astro.props

const locale: Locale = pageLocale(Astro, lang)
const t = useTranslations(locale)

/* Nav labels come from the dictionary so the default links stay translatable. */
const NAV_LABELS = [t("nav.home"), t("nav.trackOrder"), t("nav.shopAll")]
const navLinks: NavLink[] = links.map((link, index) => ({
  ...link,
  label: link.label || NAV_LABELS[index] || link.href,
}))

const categories: ProductCategory[] =
  categoriesProp ??
  (await getNavCategories().catch(() => [] as ProductCategory[])) ??
  []

const azGroups = groupAz(categories)
const hasAz = azGroups.some((group) => group.items.length)

const currency = currencyFromCookies(Astro.cookies)
const currencyText = currencyLabel(currency)
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"

const isActive = (link: NavLink): boolean => {
  const href = link.href.replace(/\/$/, "") || "/"
  if (link.match === "exact") return pathname === href
  return pathname === href || pathname.startsWith(`${href}/`)
}

const messages = Array.from(announcements || []).filter(Boolean)
---

<header class:list={["site-header", variant === "compact" && "site-header--compact", className]} lang={locale}>
  {messages.length > 0 && (
    <div class="announcement-bar" data-announcement-bar>
      {messages.map((message, index) => (
        <p class:list={["announcement-msg", index === 0 && "is-active"]}>{message}</p>
      ))}
    </div>
  )}

  <div class="page-width header-row">
    <div class="header-cell header-cell--start">
      {showMenuButton && (
        <button
          id="headerMenuBtn"
          class="icon-btn header-menu-btn"
          type="button"
          data-open-nav
          aria-label={t("a11y.openMenu")}
          aria-controls="mobileNav"
          aria-expanded="false"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </button>
      )}
    </div>

    <a href="/" class="logo-text" rel="home" aria-label={`${SITE.name} — ${t("nav.home")}`}>
      {SITE.name}
    </a>

    <div class="header-icons">
      <div class="currency-wrap icon-hide-mobile">
        <button
          id="currencyBtn"
          class="icon-btn icon-btn--wide"
          type="button"
          data-currency-toggle="currencyMenu"
          aria-label={`${t("a11y.currency")}: ${currencyText}`}
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="currencyMenu"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span class="icon-btn__label" data-currency-label>{currencyText}</span>
        </button>
        <div id="currencyMenu" class="currency-menu" role="listbox" data-currency-menu aria-label={t("a11y.currency")}>
          <p class="currency-menu__hint">{t("a11y.currency")}</p>
          {CURRENCY_OPTIONS.map((option) => (
            <button
              type="button"
              class="currency-option"
              role="option"
              data-currency={option.code}
              data-currency-active=""
              aria-selected={option.code === currency ? "true" : "false"}
            >
              <span aria-hidden="true">{option.flag}</span> {option.label}
            </button>
          ))}
        </div>
      </div>

      <button class="icon-btn" type="button" data-open-search aria-label={t("a11y.openSearch")} aria-haspopup="dialog">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
        </svg>
      </button>

      <a href="/account" class="icon-btn icon-hide-mobile" data-account-link aria-label={t("a11y.account")}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />
        </svg>
        <span class="account-dot" data-account-dot hidden aria-hidden="true"></span>
      </a>

      <a href="/wishlist" class="icon-btn" aria-label={t("a11y.wishlist")}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />
        </svg>
        <span class="cart-count" data-wish-count hidden>0</span>
      </a>

      <button
        class="icon-btn"
        type="button"
        data-open-cart
        data-cart-label
        aria-label={t("a11y.openCart")}
        aria-controls="cartDrawer"
        aria-haspopup="dialog"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <circle cx="8" cy="21" r="1" /><circle cx="19" cy="21" r="1" /><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
        </svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>

  <nav class="page-width nav-row desktop-nav" aria-label={t("a11y.mainNavigation")}>
    <ul class="nav-list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link" aria-current={isActive(link) ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ))}
      {hasAz && (
        <li>
          <details class="nav-details az-details" data-nav-dropdown>
            <summary class="nav-link" aria-haspopup="true">
              <span>{t("nav.animeList")}</span>
              <svg class="icon-caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                <path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="az-dropdown" data-az-dropdown>
              {azGroups.map((group) => (
                <div class="az-group">
                  <p class="az-letter" aria-hidden="true">{group.letter}</p>
                  <ul>
                    {group.items.map((child) => (
                      <li>
                        <a class="az-link truncate" href={`/collections/${child.handle}`}>{child.name}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </li>
      )}
    </ul>
  </nav>
</header>

<div id="navOverlay" class="overlay" data-overlay hidden></div>

<aside
  id="mobileNav"
  class="drawer drawer-left"
  aria-hidden="true"
  aria-label={t("a11y.mainNavigation")}
  inert
>
  <div class="drawer-head">
    <span class="logo-text" aria-hidden="true">{SITE.name}</span>
    <button class="close-x" type="button" data-close-nav aria-label={t("a11y.closeMenu")}>×</button>
  </div>

  <nav class="drawer-body drawer-body--nav" aria-label={t("a11y.mainNavigation")}>
    <ul class="mobile-nav-list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link mobile-nav-link" aria-current={isActive(link) ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ))}
      {hasAz && (
        <li>
          <details class="mobile-az" data-nav-dropdown>
            <summary class="nav-link mobile-nav-link">{t("nav.animeList")}</summary>
            <div class="az-mobile" data-az-mobile id="azMobile">
              {azGroups.map((group) => (
                <div class="az-group">
                  <p class="az-letter" aria-hidden="true">{group.letter}</p>
                  <ul>
                    {group.items.map((child) => (
                      <li><a class="truncate" href={`/collections/${child.handle}`}>{child.name}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </li>
      )}
      <li><a href="/account" class="nav-link mobile-nav-link" data-account-link>{t("nav.account")}</a></li>
      <li><a href="/wishlist" class="nav-link mobile-nav-link">{t("nav.wishlist")}</a></li>
      <li><a href="/search" class="nav-link mobile-nav-link">{t("nav.search")}</a></li>
    </ul>

    <div class="mobile-currency">
      <p class="az-letter">{t("a11y.currency")}</p>
      <div
        class="mobile-currency__options"
        id="currencyMenuMobile"
        role="listbox"
        data-currency-menu
        aria-label={t("a11y.currency")}
      >
        {CURRENCY_OPTIONS.map((option) => (
          <button
            type="button"
            class="currency-option"
            role="option"
            data-currency={option.code}
            aria-selected={option.code === currency ? "true" : "false"}
          >
            <span aria-hidden="true">{option.flag}</span> {option.label}
          </button>
        ))}
      </div>
    </div>
  </nav>
</aside>
