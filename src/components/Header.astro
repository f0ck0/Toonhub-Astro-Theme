---
import { getNavCategories } from "../lib/medusa"
import { SITE, groupAz } from "../lib/site"
import { currencyFromCookies, currencyLabel, CURRENCY_OPTIONS } from "../lib/currency"

let categories: any[] = []
try {
  categories = await getNavCategories()
} catch (e) {}

const azGroups = groupAz(categories)
const currency = currencyFromCookies(Astro.cookies)
---
<header class="site-header">
  <div class="announcement-bar" aria-live="polite">
    {SITE.announcements.map((msg, i) => (
      <span class:list={["announcement-msg", i === 0 && "is-active"]}>{msg}</span>
    ))}
  </div>

  <div class="page-width header-row">
    <div>
      <button id="mobileMenuBtn" class="icon-btn header-menu-btn" data-open-nav type="button" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>

    <a href="/" class="logo-text" style="justify-self:center;">{SITE.name}</a>

    <div class="header-icons">
      <div class="currency-wrap icon-hide-mobile">
        <button id="currencyBtn" class="icon-btn wide" type="button" aria-label="Currency" aria-haspopup="listbox" aria-expanded="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span id="currencyLabel">{currencyLabel(currency)}</span>
        </button>
        <div id="currencyMenu" class="currency-menu" role="listbox">
          <div style="padding:6px 10px;font-size:0.72rem;color:#888;text-transform:uppercase;letter-spacing:0.08em;">Country / currency</div>
          {CURRENCY_OPTIONS.map((opt) => (
            <button data-currency={opt.code} class="currency-option" type="button">{opt.flag} {opt.label}</button>
          ))}
        </div>
      </div>
      <button class="icon-btn" type="button" data-open-search aria-label="Search">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <a href="/account" class="icon-btn icon-hide-mobile" data-account-link aria-label="Account">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span class="account-dot" data-account-dot hidden></span>
      </a>
      <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        <span class="cart-count" data-wish-count hidden>0</span>
      </a>
      <button class="icon-btn" type="button" data-open-cart aria-label="Cart">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>

  <nav class="page-width nav-row desktop-nav">
    <a href="/" class="nav-link">Home</a>
    <a href="/track-order" class="nav-link">Track Order</a>
    <a href="/collections" class="nav-link">Shop All</a>
    <details class="nav-details az-details">
      <summary class="nav-link">
        <span>Anime List (A-Z)</span>
        <svg class="icon-caret" width="10" height="6" viewBox="0 0 10 6"><path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd"></path></svg>
      </summary>
      <div class="az-dropdown">
        {azGroups.map((g) => (
          <div class="az-group">
            <div class="az-letter">{g.letter}</div>
            {g.items.map((child) => (
              <a href={`/collections/${child.handle}`}>{child.name}</a>
            ))}
          </div>
        ))}
      </div>
    </details>
  </nav>

</header>

<div id="navOverlay" class="overlay"></div>
<aside id="mobileNav" class="drawer drawer-left" aria-hidden="true" inert>
  <div class="drawer-head">
    <span class="logo-text" style="font-size:22px;">{SITE.name}</span>
    <button class="close-x" type="button" data-close-nav aria-label="Close">×</button>
  </div>
  <nav class="drawer-body" style="display:flex;flex-direction:column;gap:4px;">
    <a href="/" class="nav-link mobile-nav-link">Home</a>
    <a href="/track-order" class="nav-link mobile-nav-link">Track Order</a>
    <a href="/collections" class="nav-link mobile-nav-link">Shop All</a>
    <details class="mobile-az">
      <summary class="nav-link mobile-nav-link">Anime List (A-Z)</summary>
      <div id="azMobile">
        {azGroups.map((g) => (
          <>
            <div class="az-letter">{g.letter}</div>
            {g.items.map((child) => (
              <a href={`/collections/${child.handle}`}>{child.name}</a>
            ))}
          </>
        ))}
      </div>
    </details>
    <a href="/account" class="nav-link mobile-nav-link" data-account-link>Account</a>
    <a href="/wishlist" class="nav-link mobile-nav-link">Wishlist</a>
    <a href="/search" class="nav-link mobile-nav-link">Search</a>
    <div class="mobile-currency">
      <div class="az-letter" style="padding:16px 8px 6px;">Country / currency</div>
      {CURRENCY_OPTIONS.map((opt) => (
        <button data-currency={opt.code} class="currency-option mobile-currency-opt" type="button">{opt.flag} {opt.label}</button>
      ))}
    </div>
  </nav>
</aside>

<script>
  const currencyBtn = document.getElementById("currencyBtn")
  const currencyMenu = document.getElementById("currencyMenu")
  const currencyWrap = currencyBtn?.closest(".currency-wrap")
  if (currencyBtn && currencyMenu) {
    currencyBtn.onclick = (e) => {
      e.stopPropagation()
      const open = currencyMenu.classList.toggle("open")
      currencyBtn.setAttribute("aria-expanded", open ? "true" : "false")
    }
    document.addEventListener("click", (e) => {
      if (currencyWrap?.contains(e.target as Node)) return
      currencyMenu.classList.remove("open")
      currencyBtn.setAttribute("aria-expanded", "false")
    })
    currencyMenu.querySelectorAll<HTMLElement>(".currency-option").forEach((opt) => {
      opt.onclick = () => {
        const code = opt.getAttribute("data-currency")
        document.cookie = `toonhub_currency=${code}; path=/; max-age=31536000; samesite=lax`
        window.location.reload()
      }
    })
  }

  try {
    if (localStorage.getItem("toonhub_token")) {
      document.querySelectorAll<HTMLElement>("[data-account-dot]").forEach((el) => { el.hidden = false })
    }
  } catch {}

  document.querySelectorAll<HTMLElement>(".mobile-currency-opt").forEach((opt) => {
    opt.onclick = () => {
      const code = opt.getAttribute("data-currency")
      document.cookie = `toonhub_currency=${code}; path=/; max-age=31536000; samesite=lax`
      window.location.reload()
    }
  })

  const details = document.querySelectorAll<HTMLDetailsElement>("details.nav-details")
  details.forEach((d) => {
    d.addEventListener("mouseenter", () => { d.open = true })
    d.addEventListener("mouseleave", () => { d.open = false })
  })
</script>
