---
import { getAllCategories } from "../lib/medusa"

let categories: any[] = []
try {
    categories = await getAllCategories()
} catch (e) {}

const parentCats = categories.filter((c: any) => !c.parent_category_id)
const childMap: Record<string, any[]> = {}
for (const c of categories) {
    if (c.parent_category_id) {
        if (!childMap[c.parent_category_id]) childMap[c.parent_category_id] = []
        childMap[c.parent_category_id].push(c)
    }
}
// "Figures" 顶级分类的 id，用于 Anime List (A-Z) 下拉列出全部 IP 子分类
const figuresCatId = categories.find((c: any) => c.handle === "figures-100028")?.id || ""
// 顶部导航: Home / Shop All / Anime List(A-Z) / 其余顶级分类
const navParents = parentCats.filter((c: any) => c.id !== figuresCatId)
---
<header class="sticky top-0 z-50" style="background:#000;border-bottom:1px solid var(--color-border);">
    <!-- Announcement bar (tsukiyashop-style) -->
    <div class="announcement-bar">World's Leading Anime Figures Collection — Free Shipping Ends Soon</div>

    <!-- Row 1: logo (centered) + icons (right) — tsukiyashop header--top-center -->
    <div class="page-width" style="height:88px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;">
        <!-- Left spacer -->
        <div></div>

        <!-- Center: logo -->
        <a href="/" style="justify-self:center;display:flex;align-items:center;text-decoration:none;">
            <span style="font-size:30px;font-weight:700;letter-spacing:0.04em;color:#fff;font-family:var(--font-heading);">TOONHUB</span>
        </a>

        <!-- Right: currency + search + login + cart -->
        <div class="flex items-center gap-2" style="justify-self:end;">
            <button id="currencyBtn" class="flex items-center gap-1" style="background:none;border:none;color:#fff;font-size:0.85rem;letter-spacing:0.04em;padding:6px 8px;text-transform:uppercase;" aria-label="Currency">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <span id="currencyLabel">USD $</span>
            </button>
            <a href="/search" class="flex items-center justify-center" style="width:40px;height:40px;color:#fff;" aria-label="Search">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </a>
            <a href="/account" class="hidden sm:flex items-center justify-center" style="width:40px;height:40px;color:#fff;" aria-label="Account">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </a>
            <a href="/cart" class="flex items-center justify-center" style="width:40px;height:40px;color:#fff;position:relative;" aria-label="Cart">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            </a>
            <button id="mobileMenuBtn" class="mobile-menu-btn flex items-center justify-center sm:hidden" style="width:40px;height:40px;color:#fff;background:none;border:none;" aria-label="Menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
            </button>
        </div>
    </div>

    <!-- Row 2: navigation menu — own row below the logo (tsukiyashop header__inline-menu) -->
    <nav class="page-width nav-row desktop-nav" style="display:flex;justify-content:center;align-items:center;gap:2px;border-top:1px solid var(--color-border);">
        <a href="/" class="nav-link" style="padding:14px 20px;font-size:0.9rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#fff;display:block;">Home</a>
        <a href="/categories/figures-100028" class="nav-link" style="padding:14px 20px;font-size:0.9rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#fff;display:block;">Shop All</a>
        <header-menu style="position:relative;">
            <details class="nav-details" style="position:static;">
                <summary class="nav-link" style="list-style:none;padding:14px 20px;font-size:0.9rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#fff;cursor:pointer;display:flex;align-items:center;gap:6px;">
                    <span>Anime List (A-Z)</span>
                    <svg class="icon-caret" width="10" height="6" viewBox="0 0 10 6"><path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd"></path></svg>
                </summary>
                <ul style="position:absolute;top:100%;left:50%;transform:translateX(-50%);width:min(100vw,var(--page-width));list-style:none;margin:0;padding:14px 0;background:#000;border:1px solid var(--color-border);border-top:none;display:grid;grid-template-columns:repeat(6,1fr);gap:2px 16px;z-index:100;max-height:70vh;overflow-y:auto;">
                    {childMap[figuresCatId]?.map((child) => (
                        <li><a href={`/categories/${child.handle}`} style="display:block;padding:8px 14px;font-size:0.82rem;font-weight:700;color:#ccc;text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;border-radius:4px;transition:background 150ms ease,color 150ms ease;" onmouseover="this.style.background='#1a1a1a';this.style.color='#fff'" onmouseout="this.style.background='transparent';this.style.color='#ccc'">{child.name}</a></li>
                    ))}
                </ul>
            </details>
        </header-menu>
        {parentCats.filter((c) => c.id !== figuresCatId).map((cat) => (
            <a href={`/categories/${cat.handle}`} class="nav-link" style="padding:14px 20px;font-size:0.9rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#fff;display:block;">{cat.name}</a>
        ))}
    </nav>

    <!-- Mobile menu -->
    <div id="mobileMenu" style="display:none;padding:16px;background:#000;border-top:1px solid var(--color-border);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <span style="font-size:20px;font-weight:700;color:#fff;font-family:var(--font-heading);">TOONHUB</span>
            <button id="closeMobileMenu" style="font-size:24px;background:none;border:none;color:#fff;cursor:pointer;">×</button>
        </div>
        {parentCats.map((cat) => (
            <div style="margin-bottom:12px;">
                <a href={`/categories/${cat.handle}`} style="font-size:16px;font-weight:700;color:#fff;text-decoration:none;display:block;padding:8px 0;text-transform:uppercase;letter-spacing:0.05em;">{cat.name}</a>
                {childMap[cat.id]?.map((child) => (
                    <a href={`/categories/${child.handle}`} style="font-size:13px;color:#999;text-decoration:none;display:block;padding:4px 16px;text-transform:uppercase;">{child.name}</a>
                ))}
            </div>
        ))}
        <a href="/search" style="font-size:16px;font-weight:700;color:#fff;text-decoration:none;display:block;padding:8px 0;text-transform:uppercase;">Search</a>
    </div>

    <!-- Currency picker dropdown -->
    <div id="currencyMenu" style="display:none;position:absolute;right:1.5rem;top:88px;background:#111;border:1px solid var(--color-border);border-radius:0.3rem;padding:8px;z-index:60;min-width:180px;max-height:320px;overflow-y:auto;">
        <div style="padding:6px 10px;font-size:0.72rem;color:#888;text-transform:uppercase;letter-spacing:0.08em;">Select currency</div>
        <button data-currency="usd" class="currency-option" style="display:block;width:100%;text-align:left;padding:8px 10px;background:none;border:none;color:#fff;font-size:0.85rem;cursor:pointer;border-radius:0.2rem;">🇺🇸 USD $ — US Dollar</button>
        <button data-currency="eur" class="currency-option" style="display:block;width:100%;text-align:left;padding:8px 10px;background:none;border:none;color:#fff;font-size:0.85rem;cursor:pointer;border-radius:0.2rem;">🇪🇺 EUR € — Euro</button>
        <button data-currency="gbp" class="currency-option" style="display:block;width:100%;text-align:left;padding:8px 10px;background:none;border:none;color:#fff;font-size:0.85rem;cursor:pointer;border-radius:0.2rem;">🇬🇧 GBP £ — British Pound</button>
        <button data-currency="aud" class="currency-option" style="display:block;width:100%;text-align:left;padding:8px 10px;background:none;border:none;color:#fff;font-size:0.85rem;cursor:pointer;border-radius:0.2rem;">🇦🇺 AUD AU$ — Australian Dollar</button>
        <button data-currency="cad" class="currency-option" style="display:block;width:100%;text-align:left;padding:8px 10px;background:none;border:none;color:#fff;font-size:0.85rem;cursor:pointer;border-radius:0.2rem;">🇨🇦 CAD CA$ — Canadian Dollar</button>
        <button data-currency="jpy" class="currency-option" style="display:block;width:100%;text-align:left;padding:8px 10px;background:none;border:none;color:#fff;font-size:0.85rem;cursor:pointer;border-radius:0.2rem;">🇯🇵 JPY ¥ — Japanese Yen</button>
        <button data-currency="cny" class="currency-option" style="display:block;width:100%;text-align:left;padding:8px 10px;background:none;border:none;color:#fff;font-size:0.85rem;cursor:pointer;border-radius:0.2rem;">🇨🇳 CNY CN¥ — Chinese Yuan</button>
    </div>
</header>

<script>
    const btn = document.getElementById('mobileMenuBtn')
    const menu = document.getElementById('mobileMenu')
    const closeBtn = document.getElementById('closeMobileMenu')
    if (btn) btn.onclick = () => { if (menu) menu.style.display = 'block' }
    if (closeBtn) closeBtn.onclick = () => { if (menu) menu.style.display = 'none' }

    // ---- Currency picker ----
    const currencyBtn = document.getElementById('currencyBtn')
    const currencyMenu = document.getElementById('currencyMenu')
    if (currencyBtn && currencyMenu) {
        currencyBtn.onclick = (e) => {
            e.stopPropagation()
            currencyMenu.style.display = currencyMenu.style.display === 'block' ? 'none' : 'block'
        }
        document.addEventListener('click', (e) => {
            if (!currencyMenu.contains(e.target) && e.target !== currencyBtn) {
                currencyMenu.style.display = 'none'
            }
        })
        currencyMenu.querySelectorAll('.currency-option').forEach((opt) => {
            opt.onclick = () => {
                const code = opt.getAttribute('data-currency')
                try {
                    document.cookie = `toonhub_currency=${code}; path=/; max-age=31536000; samesite=lax`
                } catch (e) {}
                window.location.reload()
            }
        })
    }
</script>

<style>
    @media (max-width: 990px) {
        .desktop-nav { display: none !important; }
        .mobile-menu-btn { display: flex !important; }
    }
    .nav-row { position: relative; }
    .dropdown-menu {
        position: absolute;
        top: 100%; left: 50%;
        transform: translateX(-50%);
        width: min(100vw, var(--page-width));
        background: #000;
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
        opacity: 0; visibility: hidden;
        transition: opacity 220ms ease, visibility 220ms;
        z-index: 100;
    }
    .dropdown-trigger:hover .dropdown-menu,
    .dropdown-trigger:focus-within .dropdown-menu {
        opacity: 1; visibility: visible;
    }
    .mobile-menu-btn { display: none; }
</style>
