---
---
<div id="quickView" class="qv" role="dialog" aria-label="Choose options">
  <div class="qv-panel">
    <div style="background:#111;">
      <img id="qvImage" alt="" style="width:100%;aspect-ratio:1;object-fit:cover;" />
    </div>
    <div style="padding:24px;position:relative;">
      <button class="close-x" type="button" data-close-qv aria-label="Close" style="position:absolute;top:8px;right:8px;">×</button>
      <h2 id="qvTitle" style="font-size:1.2rem;padding-right:32px;"></h2>
      <div id="qvPrice" class="pc-price" style="margin-top:10px;"></div>
      <p class="limited-banner">Limited Offer · Buy 1 get 2nd 50% off. Add 2 items and the deal applies automatically.</p>
      <div style="margin-top:18px;">
        <div style="font-size:0.82rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:8px;">Select option</div>
        <div id="qvVariants" class="pdp-size-row"></div>
      </div>
      <div style="margin-top:18px;display:flex;align-items:center;gap:12px;">
        <span style="font-size:0.82rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">Quantity</span>
        <div id="qvQtyRow" class="qty-row">
          <button type="button" data-qv-qty="-1">−</button>
          <span id="qvQty">1</span>
          <button type="button" data-qv-qty="1">+</button>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:22px;">
        <button id="qvBuy" class="btn btn-primary btn-block" type="button" data-action="buynow">Buy now — checkout</button>
        <button id="qvAdd" class="btn btn-outline btn-block" type="button" data-action="add">Add to cart</button>
      </div>
    </div>
  </div>
</div>
