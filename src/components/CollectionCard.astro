---
/**
 * <CollectionCard /> — a "Shop by List" tile.
 *
 * Accepts either a Medusa category or explicit props, resolves bundled artwork
 * first (optimised AVIF/WebP through `astro:assets`) and falls back to the
 * category's first product thumbnail, then to a typographic placeholder.
 * Long names are truncated with `text-overflow: ellipsis`; blurbs are clamped
 * to two lines so a 60-character description cannot break the grid.
 */
import Media from "./Media.astro"
import { IMAGE_SIZES, IMAGE_WIDTHS, categoryImage } from "../lib/images"
import { categoryBlurb } from "../lib/site"
import { pageLocale, useTranslations, type Locale } from "../lib/i18n"
import type { ImageSource, ProductCategory } from "../types"

export interface Props {
  /** Full category — when given, `name`/`handle`/`image` are derived from it. */
  category?: ProductCategory | null
  name?: string
  handle?: string
  /** Overrides the resolved artwork. */
  img?: ImageSource
  description?: string
  /** Absolute or root-relative override for the tile link. */
  href?: string
  /** Product count, rendered as a subtle meta line when > 0. */
  count?: number
  /** Above-the-fold tile: eager + high fetch priority. */
  priority?: boolean
  /** Show the blurb (hidden on small screens by CSS). */
  showDescription?: boolean
  /** Heading level for the tile title — 2 directly under a page `<h1>`. */
  headingLevel?: 2 | 3 | 4
  /** CSS `sizes` for the tile artwork. Defaults to the "Shop by List" grid. */
  sizes?: string
  /** Srcset widths for the tile artwork. Defaults to the tile ladder. */
  widths?: readonly number[]
  class?: string
  lang?: string
}

const {
  category = null,
  name,
  handle,
  img,
  description,
  href,
  count = 0,
  priority = false,
  showDescription = true,
  headingLevel = 3,
  sizes = IMAGE_SIZES.tile,
  widths = IMAGE_WIDTHS.tile,
  class: className = "",
  lang,
} = Astro.props

const locale: Locale = pageLocale(Astro, lang)
const t = useTranslations(locale)

const title = String(name || category?.name || "").trim()
const slug = String(handle || category?.handle || "").trim()
const url = href || (slug ? `/collections/${encodeURIComponent(slug)}` : "")
const blurb = String(description || categoryBlurb(title)).trim()
const source = img ?? categoryImage(category)
const Heading = `h${headingLevel}` as "h2" | "h3" | "h4"
---

{title && (
  <a href={url || "#"} class:list={["shopby-tile", "card", className]} aria-label={title}>
    <div class="shopby-media">
      <Media
        src={source}
        alt=""
        width={400}
        height={400}
        ratio="1 / 1"
        sizes={sizes}
        widths={widths}
        priority={priority}
        placeholderLabel={title}
        imgClass="shopby-media__img"
      />
    </div>

    <div class="shopby-heading">
      <Heading class="shopby-heading__title truncate">{title}</Heading>
      <svg class="icon-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
        <path fill="currentColor" fill-rule="evenodd" d="M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546" clip-rule="evenodd" />
      </svg>
    </div>

    {showDescription && blurb && (
      <p class="shopby-blurb line-clamp" style="--line-clamp:2;">{blurb}</p>
    )}
    {count > 0 && (
      <p class="shopby-count">{t("grid.productCount", { count })}</p>
    )}
  </a>
)}

{!title && (
  <p class="sr-only">{t("grid.emptyTitle")}</p>
)}
