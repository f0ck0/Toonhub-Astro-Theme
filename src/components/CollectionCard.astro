---
import { cardImage } from "../lib/img"

const { name, handle, description, img, href, eager = false, high = false } = Astro.props
const url = href || `/collections/${handle}`
const pic = cardImage(img)
---
<a href={url} class="shopby-tile card">
  <div class="shopby-media">
    {pic.src ? (
      <img
        src={pic.src}
        alt={name}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={high ? "high" : undefined}
        decoding="async"
        width="400"
        height="400"
      />
    ) : (
      <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#555;font-family:var(--font-heading);text-transform:uppercase;padding:12px;text-align:center;">{name}</div>
    )}
  </div>
  <div class="shopby-heading">
    <h3 style="font-family:'Asul',Georgia,serif;font-weight:400;font-style:normal;text-transform:none;letter-spacing:0.03em;">{name}</h3>
    <svg class="icon-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none"><path fill="currentColor" fill-rule="evenodd" d="M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546" clip-rule="evenodd"/></svg>
  </div>
  {description && (
    <p style="color:#999;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-family:'Quattrocento Sans',Arial,sans-serif;font-style:italic;font-weight:400;">{description}</p>
  )}
</a>
