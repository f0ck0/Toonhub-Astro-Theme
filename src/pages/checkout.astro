---
import "../styles/checkout.css"
import "../styles/checkout-layout.css"
import { SITE } from "../lib/site"
import { COUNTRIES } from "../lib/regions"
import TrustIcons from "../components/TrustIcons.astro"
export const prerender = false
---
<!DOCTYPE html>
<html lang="en" style="background:#000;color-scheme:dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#000000" />
  <title>Checkout — {SITE.name}</title>
  <link rel="stylesheet" href="/fonts/fonts.css?v=cardtype3" />
  <link rel="preload" href="/fonts/asul-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/qs-400.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body class="co-body" style="background:#000;color:#fff">
  <div class="co-wrap">
    <main class="co-main">
      <a href="/" class="co-logo">{SITE.name}</a>
      <nav class="co-crumb" aria-label="Checkout progress">
        <a href="/cart">Cart</a><span aria-hidden="true">›</span>
        <span aria-current="page">Checkout</span>
      </nav>
      <h1 class="co-sr">Secure checkout</h1>
      <div class="co-offer">
        <strong>Limited offer</strong><br />
        Buy 1 get 2nd 50% off · Free worldwide shipping · 30-day returns
      </div>

      <form id="coForm" autocomplete="on">
        <div class="co-left">
        <div id="savedBox" class="co-saved" hidden>
          <div>
            <div class="co-saved-k">Deliver to</div>
            <b id="savedName"></b>
            <div id="savedLine"></div>
            <div id="savedMail"></div>
          </div>
          <button type="button" class="co-text-btn" id="editAddr">Change</button>
        </div>

        <div id="addrFields">
        <h2 class="co-h">Contact</h2>
        <div class="co-row">
          <input class="co-field" type="email" name="email" id="coEmail" placeholder="Email" aria-label="Email" required autocomplete="email" inputmode="email" />
        </div>

        <h2 class="co-h">Delivery</h2>
        <div class="co-row">
          <select class="co-field" name="country" id="countrySelect" required autocomplete="country-name" aria-label="Country / region">
            {COUNTRIES.map((c) => <option value={c.code}>{c.name}</option>)}
            <option value="OTHER">Other / not listed</option>
          </select>
        </div>
        <div class="co-row" id="countryOtherRow" hidden>
          <input class="co-field" name="countryOther" id="countryOther" placeholder="Country name" aria-label="Country name" autocomplete="country-name" />
          <p class="co-ship-line" style="margin:4px 0 0;">We’ll use this to ship to you. If it isn’t a standard country code, we’ll email to confirm.</p>
        </div>
        <div class="co-row">
          <input class="co-field" name="name" id="coName" placeholder="Full name" aria-label="Full name" required autocomplete="name" />
        </div>
        <div class="co-row">
          <input class="co-field" name="address" placeholder="Address" aria-label="Address" required autocomplete="address-line1" />
        </div>
        <button type="button" class="co-text-btn" id="toggleApt">+ Apartment, suite</button>
        <div class="co-row" id="aptRow" hidden>
          <input class="co-field" name="apartment" placeholder="Apartment, suite, etc." aria-label="Apartment, suite, etc." autocomplete="address-line2" />
        </div>
        <div class="co-row">
          <input class="co-field" name="city" placeholder="City" aria-label="City" required autocomplete="address-level2" />
        </div>
        <div class="co-row">
          <input class="co-field" name="postal" placeholder="Postal code" aria-label="Postal code" required autocomplete="postal-code" />
        </div>
        <div class="co-row" id="regionPhoneRow">
          <select class="co-field" name="province" id="provinceSelect" autocomplete="address-level1" aria-label="Province / state">
            <option value="">Province / state</option>
          </select>
          <input class="co-field" name="provinceText" id="provinceText" placeholder="Province / state (optional)" aria-label="Province / state" autocomplete="address-level1" hidden />
        </div>
        <button type="button" class="co-text-btn" id="togglePhone">+ Phone for delivery updates</button>
        <div class="co-row" id="phoneRow" hidden>
          <input class="co-field" name="phone" placeholder="Phone" aria-label="Phone" autocomplete="tel" inputmode="tel" />
        </div>
        </div>

        <p class="co-ship-line" id="shipList">Free worldwide shipping included</p>
        <input type="checkbox" name="newsletter" checked hidden aria-label="Email me news and offers" />

        <h2 class="co-h">Payment</h2>
        <div class="co-pay-reserved" id="payReserved">
          <b>Reserved for PayPal / Stripe / wallets</b>
          Payment methods appear here after they are connected in Medusa. You can still place the order — we will email the next step.
        </div>
        <div class="co-method" id="payList" hidden></div>
        <div class="co-card-box" id="cardBox" hidden>
          <div id="card-element"></div>
          <div id="card-errors" class="co-error"></div>
        </div>

        <TrustIcons gift />

        <p id="coError" class="co-error" hidden></p>
        </div>

        <aside class="co-aside is-open">
          <div class="co-summary-head">
            <span>Your order</span>
            <b id="coTotalMini">—</b>
          </div>
          <div class="co-aside-body" id="asideBody">
            <div id="coLines"></div>
            <div class="co-discount">
              <input class="co-field" id="discountCode" name="discountCode" placeholder="Discount code" aria-label="Discount code" autocomplete="off" />
              <button type="button" id="discountBtn">Apply</button>
            </div>
            <div class="co-totals">
              <div class="co-tot-row"><span>Subtotal</span><span id="coSub">—</span></div>
              <div class="co-tot-row"><span>Shipping</span><span id="coShip">Free</span></div>
              <div class="co-tot-row" id="coDiscRow" hidden><span>Buy 1 get 2nd 50% off</span><span id="coDisc">—</span></div>
              <div class="co-tot-row grand"><span>Total</span><span id="coTotal">—</span></div>
            </div>
          </div>
        </aside>

        <button type="submit" class="co-btn pay" id="payBtn">Place order — free shipping</button>
        <div class="co-foot">
          <a href="/cart">‹ Cart</a>
          <span>Secure checkout</span>
        </div>
        <p class="co-lock">By placing this order you agree to our <a href="/policies/terms-of-service">Terms</a> and <a href="/policies/privacy-policy">Privacy Policy</a>.</p>
      </form>
    </main>

  </div>

  <script>import "../scripts/checkout"</script>
</body>
</html>
