---
import Base from "../../layouts/Base.astro"
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import ProductCard from "../../components/ProductCard.astro"
import Stars from "../../components/Stars.astro"
import { getProduct, getProducts, productImageUrl, getProductUsdPrice } from "../../lib/medusa"
import { salePrice, formatPriceFrom, formatCurrency, currencyFromCookies } from "../../lib/currency"
import { productSocial, SITE } from "../../lib/site"

const { id } = Astro.params
let product: any = null
let relatedProducts: any[] = []

try {
  product = await getProduct(id || "")
  if (product) {
    const result = await getProducts(8, 0)
    relatedProducts = result.products.filter((p: any) => p.id !== product.id).slice(0, 4)
  }
} catch (e) { console.error("Failed:", e) }

const images = product?.images || []
const allImages = [product?.thumbnail, ...images.map((i: any) => i.url)].filter(Boolean).filter((v: string, i: number, a: string[]) => a.indexOf(v) === i)
const usdPrice = getProductUsdPrice(product) || 0
const currency = currencyFromCookies(Astro.cookies)
const { original, sale } = salePrice(usdPrice, currency)
const priceFrom = formatPriceFrom(sale, currency)
const originalFmt = formatCurrency(original, currency)
const variants = product?.variants || []
const variantId = variants[0]?.id || ""
const cat = product?.categories?.[0]
const parentCat = product?.categories?.find((c: any) => c.parent_category_id) || cat
const { rating, count } = productSocial(product?.id || "")
const options = product?.options || []
---
<Base title={product ? `${product.title} — TOONHUB` : "Product — TOONHUB"} description={product?.subtitle || SITE.description}>
  <Header />
  {product ? (
    <main id="MainContent">
      <section class="page-width" style="padding:24px 0 8px;">
        <nav class="breadcrumb">
          <a href="/">Home</a>
          {parentCat && <><span>/</span><a href={`/collections/${parentCat.handle}`}>{parentCat.name}</a></>}
          <span>/</span>
          <span style="color:#fff;">{product.title}</span>
        </nav>
      </section>

      <section class="page-width" style="padding:8px 0 40px;">
        <div class="pdp-grid">
          <div>
            <div style="position:relative;background:#111;overflow:hidden;border-radius:var(--radius-card);">
              <img id="mainImage" src={productImageUrl(allImages[0] || "")} alt={product.title} style="width:100%;aspect-ratio:1;object-fit:cover;display:block;cursor:zoom-in;" />
              <span class="sale-badge">Sale</span>
            </div>
            {allImages.length > 1 && (
              <div class="thumb-row">
                {allImages.map((img: string, idx: number) => (
                  <img src={productImageUrl(img)} alt={`Image ${idx + 1}`} data-idx={idx} class:list={["thumb-img", idx === 0 && "is-on"]} loading="lazy" />
                ))}
              </div>
            )}
          </div>

          <div>
            <Stars rating={rating} count={count} size="0.95rem" />
            <h1 style="font-size:1.6rem;font-weight:700;line-height:1.25;color:#fff;margin-top:10px;">{product.title}</h1>
            {product.subtitle && <p style="font-size:0.95rem;color:#999;margin-top:8px;">{product.subtitle}</p>}

            <div class="limited-banner">
              <strong>Limited Offer</strong> 🎁 Buy 1 Get 2ND 50% OFF. Add 2 items and the deal applies automatically.
            </div>

            <div class="pc-price-row" style="margin-top:16px;">
              <span class="pdp-price" style="font-size:1.5rem;font-weight:700;">{priceFrom}</span>
              <span class="pdp-original pc-compare" style="font-size:1rem;">{originalFmt}</span>
            </div>
            <p style="font-size:0.78rem;color:#888;margin-top:4px;">Sale · Taxes included.</p>

            {product.description && (
              <div class="rte" style="margin-top:18px;font-size:0.9rem;" set:html={product.description} />
            )}

            {variants.length > 1 && (
              <div style="margin-top:24px;">
                <div style="font-size:0.9rem;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:8px;">
                  Select {options[0]?.title || "Option"}
                </div>
                <div class="pdp-size-row" id="variantRow">
                  {variants.map((v: any, vi: number) => (
                    <button type="button" class:list={["pdp-size-btn", vi === 0 && "is-on"]} data-variant={v.id} data-vtitle={v.title || `Option ${vi + 1}`}>
                      {v.title || `Option ${vi + 1}`}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <div style="margin-top:22px;display:flex;align-items:center;gap:12px;">
              <span style="font-size:0.82rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">Quantity</span>
              <div class="qty-row" id="pdpQtyRow">
                <button type="button" data-pdp-qty="-1" aria-label="Decrease">−</button>
                <span id="pdpQty">1</span>
                <button type="button" data-pdp-qty="1" aria-label="Increase">+</button>
              </div>
            </div>

            <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;">
              <button
                id="addToCartBtn"
                class="btn btn-primary"
                type="button"
                data-action="add"
                data-variant-id={variantId}
                data-title={product.title}
                data-thumbnail={productImageUrl(allImages[0] || "")}
                data-handle={product.handle}
                data-price={usdPrice}
                data-vtitle={variants[0]?.title || ""}
                data-qty="1"
                style="flex:1;"
              >Add to cart</button>
            </div>
            <div style="margin-top:24px;display:flex;flex-direction:column;gap:8px;font-size:0.85rem;color:#999;">
              <div>🚚 Worldwide shipping · Trackable delivery</div>
              <div>↩️ 30-day returns</div>
              <div>🔒 Secure payment · SSL encrypted</div>
              <div>🎁 Buy 1 get 2nd 50% off</div>
            </div>
          </div>
        </div>
      </section>

      <section class="page-width" style="padding:8px 0 32px;">
        <div class="pdp-accordion">
          <details open>
            <summary>Product Details</summary>
            <div class="rte" style="padding:8px 0 16px;" set:html={product.description || "Premium collectible figure. Official-quality sculpt, display ready."} />
          </details>
          <details>
            <summary>Shipping & Returns</summary>
            <div class="rte" style="padding:8px 0 16px;">
              <p>Worldwide shipping with tracking. Processing 2–3 business days. 30-day returns on unused items in original packaging. Clearance items are final sale unless damaged.</p>
            </div>
          </details>
          <details>
            <summary>Care Guide</summary>
            <div class="rte" style="padding:8px 0 16px;">
              <p>Keep figures out of direct sunlight, dust regularly with a soft brush, and avoid harsh chemicals. See our full <a href="/care-guide">Figure Care Guide</a>.</p>
            </div>
          </details>
        </div>
      </section>

      <section class="page-width" style="padding:8px 0 48px;">
        <h2 style="font-size:1.3rem;font-weight:700;color:#fff;margin-bottom:20px;">Reviews</h2>
        <div id="reviewsContainer" style="margin-bottom:32px;">
          <div style="color:#888;font-size:0.85rem;">Loading reviews...</div>
        </div>
        <div style="background:#111;padding:24px;border-radius:0.5rem;border:1px solid var(--color-border);">
          <h3 style="font-size:1rem;font-weight:700;color:#fff;margin-bottom:16px;">Write a Review</h3>
          <div style="display:flex;gap:4px;margin-bottom:12px;">
            {[1,2,3,4,5].map((n) => <span class="star-empty" data-rating={n} style="cursor:pointer;font-size:1.6rem;color:var(--color-star);">★</span>)}
          </div>
          <input id="reviewName" placeholder="Your name" class="field" style="margin-bottom:12px;" />
          <textarea id="reviewText" placeholder="Share your thoughts..." class="field" style="resize:vertical;min-height:80px;"></textarea>
          <div id="reviewError" style="display:none;color:#e53935;font-size:0.82rem;margin-top:8px;"></div>
          <button id="submitReview" class="btn btn-primary" type="button" style="margin-top:12px;" data-product-id={product.id}>Submit Review</button>
        </div>
      </section>

      {relatedProducts.length > 0 && (
        <section class="page-width" style="padding:48px 0 8px;">
          <h2 style="font-size:1.3rem;font-weight:700;color:#fff;margin-bottom:20px;">You Might Also Like</h2>
          <div class="product-grid">
            {relatedProducts.map((p: any) => <ProductCard product={p} />)}
          </div>
        </section>
      )}
      <div id="lightbox" class="lightbox"><img id="lightboxImg" alt="" /></div>
    </main>
  ) : (
    <main id="MainContent" class="page-width" style="padding:80px 0;text-align:center;">
      <h1 style="font-size:2rem;font-weight:700;color:#fff;">Product not found</h1>
      <a href="/collections/all" class="btn btn-primary" style="margin-top:24px;">Continue shopping</a>
    </main>
  )}
  <Footer />
</Base>

<script define:vars={{ allImages: allImages.map((i: string) => i), productId: product?.id }}>
  const thumbs = document.querySelectorAll<HTMLImageElement>(".thumb-img")
  const mainImg = document.getElementById("mainImage") as HTMLImageElement | null
  thumbs.forEach((t) => {
    t.addEventListener("click", () => {
      if (mainImg) mainImg.src = t.src
      thumbs.forEach((x) => x.classList.remove("is-on"))
      t.classList.add("is-on")
    })
  })
  const lb = document.getElementById("lightbox")
  const lbImg = document.getElementById("lightboxImg") as HTMLImageElement | null
  mainImg?.addEventListener("click", () => {
    if (lbImg && mainImg) lbImg.src = mainImg.src
    lb?.classList.add("open")
  })
  lb?.addEventListener("click", () => lb.classList.remove("open"))

  document.getElementById("variantRow")?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".pdp-size-btn")
    if (!btn) return
    document.querySelectorAll("#variantRow .pdp-size-btn").forEach((b) => b.classList.remove("is-on"))
    btn.classList.add("is-on")
    const addBtn = document.getElementById("addToCartBtn") as HTMLButtonElement | null
    if (addBtn) {
      addBtn.dataset.variantId = btn.dataset.variant
      addBtn.dataset.vtitle = btn.dataset.vtitle
    }
  })

  document.getElementById("pdpQtyRow")?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-pdp-qty]")
    const span = document.getElementById("pdpQty")
    const addBtn = document.getElementById("addToCartBtn") as HTMLButtonElement | null
    if (!btn || !span) return
    const n = Math.max(1, Number(span.textContent || 1) + Number(btn.dataset.pdpQty))
    span.textContent = String(n)
    if (addBtn) addBtn.dataset.qty = String(n)
  })

  const stars = document.querySelectorAll<HTMLElement>("[data-rating]")
  let selectedRating = 5
  stars.forEach((s) => {
    s.onclick = () => {
      selectedRating = parseInt(s.dataset.rating || "5")
      stars.forEach((x) => {
        const n = parseInt(x.dataset.rating || "0")
        x.style.color = n <= selectedRating ? "var(--color-star)" : "#555"
      })
    }
  })

  async function loadReviews() {
    try {
      const res = await fetch(`/api/reviews?productId=${encodeURIComponent(productId)}`)
      const data = await res.json()
      const container = document.getElementById("reviewsContainer")
      if (!container) return
      if (data.reviews?.length) {
        container.innerHTML = data.reviews.map((r: any) => `
          <div style="border-bottom:1px solid var(--color-border);padding:16px 0;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
              <div style="color:var(--color-star);font-size:0.9rem;">${"★".repeat(Math.max(1, Math.min(5, r.rating || 5)))}${"☆".repeat(5 - Math.max(1, Math.min(5, r.rating || 5)))}</div>
              <span style="font-size:0.75rem;color:#888;">${r.name || "Anonymous"}${r.created_at ? " · " + new Date(r.created_at).toLocaleDateString() : ""}</span>
            </div>
            <p style="font-size:0.85rem;color:#ddd;line-height:1.6;">${r.content || ""}</p>
            ${r.response ? `<div style="margin-top:10px;padding:10px 14px;background:#1a1a1a;border-radius:0.3rem;font-size:0.82rem;color:#bbb;"><strong style="color:#fff;">Seller response:</strong> ${r.response}</div>` : ""}
          </div>
        `).join("")
      } else {
        container.innerHTML = '<div style="color:#888;font-size:0.85rem;">No reviews yet. Be the first!</div>'
      }
    } catch (e) { console.error(e) }
  }

  const submitReview = document.getElementById("submitReview") as HTMLButtonElement | null
  if (submitReview) submitReview.onclick = async () => {
    const errEl = document.getElementById("reviewError")!
    const text = (document.getElementById("reviewText") as HTMLTextAreaElement).value.trim()
    const name = (document.getElementById("reviewName") as HTMLInputElement).value.trim()
    if (!text) { errEl.style.display = "block"; errEl.textContent = "Please write a review first."; return }
    errEl.style.display = "none"
    try {
      const res = await fetch("/api/reviews", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ productId: submitReview.dataset.productId, rating: selectedRating, content: text, name }),
      })
      const data = await res.json()
      if (!res.ok) {
        errEl.style.display = "block"
        errEl.textContent = data.error || "Failed to submit. Please try again."
        return
      }
      loadReviews()
      ;(document.getElementById("reviewText") as HTMLTextAreaElement).value = ""
      ;(document.getElementById("reviewName") as HTMLInputElement).value = ""
    } catch (e) {
      errEl.style.display = "block"
      errEl.textContent = "Network error. Please try again."
    }
  }
  loadReviews()
</script>
