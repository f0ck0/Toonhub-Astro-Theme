---
/**
 * Blog index.
 *
 * Content-collection driven: drafts are filtered out, posts are sorted newest
 * first, and an empty collection renders `<EmptyState />` rather than a blank
 * page. Hover/focus states live in CSS — no inline `onmouseover` handlers.
 */
import Base from "../../layouts/Base.astro"
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import Media from "../../components/Media.astro"
import Breadcrumb from "../../components/Breadcrumb.astro"
import EmptyState from "../../components/EmptyState.astro"
import { getCollection } from "astro:content"
import { breadcrumbJsonLd } from "../../lib/seo"
import { pageLocale, useTranslations } from "../../lib/i18n"

const t = useTranslations(pageLocale(Astro))

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const crumbs = [{ name: t("nav.home"), href: "/" }, { name: t("blog.title") }]

function formatDate(date: Date, lang: string): string {
  try {
    return date.toLocaleDateString(lang, { year: "numeric", month: "long", day: "numeric" })
  } catch {
    return date.toISOString().slice(0, 10)
  }
}

const lang = pageLocale(Astro)
---

<Base
  title={t("blog.title")}
  description={t("blog.intro")}
  canonical="/blog"
  jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}
  overlays={{ quickView: false }}
>
  <Header />

  <main id="MainContent" class="page-width blog-page">
    <Breadcrumb items={crumbs} />

    <header class="page-head">
      <h1 class="section-heading">{t("blog.title")}</h1>
      <p class="page-head__intro">{t("blog.intro")}</p>
    </header>

    {posts.length ? (
      <div class="post-list">
        {posts.map((post, index) => (
          <article class="post-card card">
            {post.data.heroImage && (
              <a class="post-card__media" href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true">
                <Media
                  src={post.data.heroImage}
                  alt=""
                  width={640}
                  height={360}
                  ratio="16 / 9"
                  sizes="(max-width: 749px) 92vw, 640px"
                  priority={index === 0}
                />
              </a>
            )}
            <div class="post-card__body">
              <p class="post-card__date">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate, lang)}
                </time>
              </p>
              <h2 class="post-card__title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              {post.data.description && (
                <p class="post-card__excerpt line-clamp" style="--line-clamp:3;">
                  {post.data.description}
                </p>
              )}
              <a class="link-btn post-card__more" href={`/blog/${post.id}`}>
                {t("blog.readMore", { title: post.data.title })}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <EmptyState
        icon="page"
        title={t("blog.empty")}
        description={t("blog.emptyHint")}
        action={{ label: t("grid.browseAll"), href: "/collections", variant: "outline" }}
      />
    )}
  </main>

  <Footer />
</Base>

<style>
  .blog-page { padding: 24px 0 64px; min-height: 50vh; }
  .page-head { margin-bottom: 28px; }
  .page-head__intro { margin-top: 8px; color: var(--text-muted); font-size: 0.9rem; max-width: 62ch; }
  .post-list { display: grid; gap: 20px; }
  .post-card {
    display: grid;
    grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
    gap: 20px;
    border: 1px solid var(--color-border);
    padding: 16px;
    transition: border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }
  .post-card:hover { border-color: var(--color-border-strong, #444); transform: translateY(-2px); }
  .post-card:focus-within { border-color: var(--focus-ring); }
  .post-card__media { display: block; }
  .post-card__date {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .post-card__title { margin-top: 8px; font-size: 1.15rem; line-height: 1.3; }
  .post-card__title a { transition: color var(--duration-fast, 120ms) var(--ease-out); }
  .post-card__title a:hover { color: #fff; text-decoration: underline; }
  .post-card__excerpt { margin-top: 8px; font-size: 0.87rem; color: var(--text-muted); line-height: 1.6; }
  .post-card__more { display: inline-flex; gap: 6px; align-items: center; margin-top: 12px; font-size: 0.82rem; }
  @media (max-width: 749px) {
    .post-card { grid-template-columns: minmax(0, 1fr); }
  }
</style>
