---
import Base from "../layouts/Base.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
---
<Base title="Track Order — TOONHUB">
  <Header />
  <main id="MainContent" class="page-width track-page">
    <h1>Track Order</h1>
    <p class="rte">Enter your order number and email to look up status. You can also track parcels at your carrier once a tracking number is emailed to you.</p>
    <form id="trackForm">
      <input class="field" name="order" placeholder="Order number" required />
      <input class="field" type="email" name="email" placeholder="Email" required />
      <button class="btn btn-primary" type="submit">Track</button>
    </form>
    <div id="trackResult" class="rte" style="margin-top:28px;max-width:520px;margin-left:auto;margin-right:auto;"></div>
  </main>
  <Footer />
</Base>
<script>
  document.getElementById("trackForm")?.addEventListener("submit", async (e) => {
    e.preventDefault()
    const fd = new FormData(e.target as HTMLFormElement)
    const id = String(fd.get("order") || "").trim()
    const email = String(fd.get("email") || "").trim().toLowerCase()
    const box = document.getElementById("trackResult")!
    box.innerHTML = `<p>Looking up your order…</p>`
    try {
      const res = await fetch(`/api/track?order=${encodeURIComponent(id)}&email=${encodeURIComponent(email)}`)
      const data = await res.json()
      if (res.ok && data.order) {
        const o = data.order
        box.innerHTML = `<h2>Order ${o.display_id || o.id}</h2><p>Status: <strong>${o.status}</strong></p><p>Placed ${o.created_at ? new Date(o.created_at).toLocaleString() : ""}.</p><p>Updates will be emailed to ${o.email}.</p>`
        return
      }
    } catch {}
    box.innerHTML = `<p>We couldn't find that Medusa order. Use the exact order number from your confirmation email.</p>`
  })
</script>
