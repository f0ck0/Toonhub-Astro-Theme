---
import Base from "../layouts/Base.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import ProductCard from "../components/ProductCard.astro"
import CollectionCard from "../components/CollectionCard.astro"
import ReviewMedals from "../components/ReviewMedals.astro"
import { getProducts, getAllCategories, productImageUrl } from "../lib/medusa"
import { SITE, COLLECTION_IMAGES, shopCategories } from "../lib/site"

let products: any[] = []
let totalCount = 0
let categories: any[] = []

try {
  categories = await getAllCategories()
} catch (e) {}

try {
  const leafCats = categories.filter((c: any) => c.parent_category_id && (c.products?.length || 0) > 0)
  const mixed: any[] = []
  for (const c of leafCats) {
    const pool = [...(c.products || [])]
    const take = Math.min(2, pool.length)
    for (let i = 0; i < take; i++) {
      const idx = Math.floor(Math.random() * pool.length)
      const p = pool.splice(idx, 1)[0]
      if (p) mixed.push(p)
    }
  }
  if (mixed.length < 24) {
    const extra = await getProducts(48, 0)
    totalCount = extra.count
    for (const p of extra.products) {
      if (!mixed.some((m: any) => m.id === p.id)) mixed.push(p)
    }
  } else {
    try {
      const extra = await getProducts(1, 0)
      totalCount = extra.count
    } catch {}
  }
  products = [...mixed].sort(() => Math.random() - 0.5).slice(0, 24)
} catch (e) {
  console.error("Failed to fetch products:", e)
}

const ipCats = shopCategories(categories)

function catTileImage(cat: any): string {
  const p = cat.products?.find((p: any) => p.thumbnail)
  return p?.thumbnail ? productImageUrl(p.thumbnail) : ""
}

const shopByList = ipCats.map((cat: any) => ({
  name: cat.name,
  handle: cat.handle,
  description: `Shop our exclusive ${cat.name} figures — premium quality, worldwide shipping.`,
  count: cat.products?.length || 0,
  img: COLLECTION_IMAGES[cat.handle] || catTileImage(cat),
}))

const featuredCols = shopByList.slice(0, 18)
const moreCols = shopByList.slice(18)
---
<Base>
  <Header />
  <main id="MainContent">
    <section class="page-width shopby-section" style="padding-top:48px;padding-bottom:8px;">
      <h2 class="section-heading" style="margin:0 0 24px;">Shop by List</h2>
      <div class="shopby-grid" data-hydrate-cats>
        {featuredCols.map((sec) => (
          <CollectionCard name={sec.name} handle={sec.handle} description={sec.description} img={sec.img} count={sec.count} />
        ))}
      </div>
    </section>

    <section class="sale-band">
      <h2>Seasonal Clearance Sale🔥</h2>
      <p>Buy 1 get Second Half Price on top of Free Shipping. Prices are also 50% off right now!</p>
      <p style="margin-top:18px;font-size:0.8rem;letter-spacing:0.12em;color:#888;">OFFER ENDS IN</p>
      <div class="countdown" id="countdown">
        <div class="unit"><b id="cdD">00</b><span>Days</span></div>
        <div class="unit"><b id="cdH">00</b><span>Hours</span></div>
        <div class="unit"><b id="cdM">00</b><span>Minutes</span></div>
        <div class="unit"><b id="cdS">00</b><span>Seconds</span></div>
      </div>
    </section>

    <div class="marquee">
      <div class="marquee-track">
        {Array.from({ length: 8 }).map(() => <span>{SITE.marquee}</span>)}
      </div>
    </div>

    <ReviewMedals />

    <section class="page-width" style="padding:48px 0 8px;" data-slider>
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
        <h2 class="section-heading" style="margin:0;">New Arrived Anime Figures</h2>
        <div style="display:flex;gap:8px;">
          <button class="slider-btn" data-prev type="button" aria-label="Previous">←</button>
          <button class="slider-btn" data-next type="button" aria-label="Next">→</button>
        </div>
      </div>
      <div class="product-drag-slider">
        <div class="slider-track" data-hydrate-products>
          {products.length > 0 ? (
            products.map((product: any) => <ProductCard product={product} />)
          ) : (
            <div style="text-align:center;padding:60px 0;width:100%;color:#888;">Loading products…</div>
          )}
        </div>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:28px;padding-top:20px;border-top:1px solid var(--color-border);flex-wrap:wrap;gap:12px;">
        <span style="font-size:0.85rem;color:#888;">Drag or use arrows to browse · {totalCount || products.length} products</span>
        <a href="/collections/new-arrivals" style="font-size:0.9rem;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:0.08em;border-bottom:1px solid #fff;padding-bottom:2px;">View all →</a>
      </div>
    </section>

    {moreCols.length > 0 && (
      <section class="page-width shopby-section" style="padding-top:64px;padding-bottom:8px;">
        <h2 class="section-heading" style="margin:0 0 24px;">400+ More Figures in Collections Below</h2>
        <div class="shopby-grid">
          {moreCols.map((sec) => (
            <CollectionCard name={sec.name} handle={sec.handle} description={sec.description} img={sec.img} count={sec.count} />
          ))}
        </div>
        <div style="text-align:center;margin-top:28px;">
          <a href="/collections" class="btn btn-outline">View all</a>
        </div>
      </section>
    )}

    <section class="page-width seo-block">
      <h2 class="section-heading">Anime Figures at Toonhub</h2>
      <p>Discover 40+ anime-inspired figure collections at Toonhub, with hundreds of unique designs featuring vibrant, detailed sculpting and dynamic themes loved by anime fans. From action-packed heroes to mystical worlds and intense fantasy battles.</p>
      <p>Our high-quality figures are perfect for collectors and otakus, offering premium materials and display-ready finishes. Every piece showcases bold colors, detailed illustration, and eye-catching aesthetics that bring your favorite anime vibes to life.</p>
    </section>
  </main>
  <Footer />
</Base>
