---
import Base from "../layouts/Base.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { SITE } from "../lib/site"
---
<Base title="Your Shopping Cart — TOONHUB">
  <Header />
  <main id="MainContent" class="page-width" style="padding:48px 0;">
    <h1 style="font-size:2rem;font-weight:700;margin-bottom:8px;">Your cart</h1>
    <p style="font-size:0.85rem;color:#888;margin-bottom:24px;"><a href="/collections/all" style="text-decoration:underline;">Continue shopping</a></p>
    <div class="offer-note">{SITE.offer}</div>
    <div class="offer-note warn">{SITE.offerWarn}</div>

    <div id="emptyCart" style="text-align:center;padding:64px 0;">
      <h2 style="font-size:1.4rem;">Your cart is empty</h2>
      <a href="/collections/all" class="btn btn-primary" style="margin-top:20px;">Continue shopping</a>
      <p style="margin-top:28px;font-size:0.9rem;color:#888;">Have an account? <a href="/account" style="text-decoration:underline;color:#fff;">Log in</a> to check out faster.</p>
    </div>

    <div id="cartItems" class="hidden">
      <div class="cart-layout">
        <div id="itemsList"></div>
        <div class="cart-summary">
          <h3 style="font-size:0.9rem;letter-spacing:0.06em;margin-bottom:16px;">Summary</h3>
          <div style="display:flex;justify-content:space-between;font-size:0.85rem;color:#999;padding:8px 0;">
            <span>Subtotal</span><span id="subtotal">$0.00</span>
          </div>
          <div id="discRow" class="hidden" style="display:flex;justify-content:space-between;font-size:0.85rem;color:#8bc34a;padding:8px 0;">
            <span>Buy 1 get 2nd 50% off</span><span id="discount">−$0.00</span>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:0.85rem;color:#999;padding:8px 0;">
            <span>Shipping</span><span>Free worldwide</span>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:1rem;font-weight:700;padding:12px 0;border-top:1px solid var(--color-border);margin-top:8px;">
            <span>Estimated total</span><span id="total">$0.00</span>
          </div>
          <p style="font-size:0.72rem;color:#666;">Taxes included. Discounts and shipping calculated at checkout.</p>
          <label class="terms-row">
            <input id="pageTerms" type="checkbox" />
            <span>I accept the <a href="/policies/terms-of-service">terms of service</a> and <a href="/policies/privacy-policy">privacy policy</a>.</span>
          </label>
          <a id="pageCheckout" href="/checkout" class="btn btn-primary btn-block" style="margin-top:8px;">Check out</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Base>
<script>
  function bogo(items: any[]) {
    const units: number[] = []
    for (const it of items) for (let i = 0; i < it.quantity; i++) units.push(it.unit_price)
    units.sort((a, b) => b - a)
    let d = 0
    for (let i = 0; i + 1 < units.length; i += 2) d += Math.round(Math.min(units[i], units[i + 1]) * 0.5)
    return d
  }

  async function loadCart() {
    await window.toonhub.refresh()
    const items = window.toonhub.getItems()
    const empty = document.getElementById("emptyCart")!
    const box = document.getElementById("cartItems")!
    if (!items.length) {
      empty.style.display = "block"
      box.classList.add("hidden")
      return
    }
    empty.style.display = "none"
    box.classList.remove("hidden")
    const fmt = window.toonhub.formatMoney
    const list = document.getElementById("itemsList")!
    list.innerHTML = items.map((item) => `
      <div style="display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--color-border);">
        <div style="width:110px;height:110px;background:#111;flex-shrink:0;overflow:hidden;border-radius:0.3rem;">
          ${item.thumbnail ? `<img src="${item.thumbnail}" style="width:100%;height:100%;object-fit:cover;" />` : ""}
        </div>
        <div style="flex:1;">
          <div style="font-size:0.95rem;font-weight:700;text-transform:uppercase;">${item.title}</div>
          ${item.variant_title ? `<div style="font-size:0.8rem;color:#888;margin-top:4px;">${item.variant_title}</div>` : ""}
          <div style="font-size:0.9rem;font-weight:700;margin-top:8px;">${fmt(item.unit_price * item.quantity)}</div>
          <div style="margin-top:10px;font-size:0.82rem;color:#888;">Qty: ${item.quantity}</div>
        </div>
      </div>
    `).join("")
    const sum = items.reduce((s, i) => s + i.unit_price * i.quantity, 0)
    const disc = bogo(items)
    document.getElementById("subtotal")!.textContent = fmt(sum)
    document.getElementById("total")!.textContent = fmt(Math.max(0, sum - disc))
    const row = document.getElementById("discRow")!
    const dEl = document.getElementById("discount")!
    row.classList.toggle("hidden", disc <= 0)
    dEl.textContent = "−" + fmt(disc)
  }

  const terms = document.getElementById("pageTerms") as HTMLInputElement
  const checkout = document.getElementById("pageCheckout") as HTMLAnchorElement
  const sync = () => {
    checkout.style.pointerEvents = terms.checked ? "" : "none"
    checkout.style.opacity = terms.checked ? "1" : "0.45"
  }
  terms?.addEventListener("change", sync)
  checkout?.addEventListener("click", (e) => { if (!terms.checked) e.preventDefault() })
  sync()
  const wait = () => {
    if (window.toonhub) loadCart()
    else setTimeout(wait, 20)
  }
  wait()
</script>
