---
/**
 * Full cart page.
 *
 * No page-local JavaScript: `scripts/cart.ts` (loaded with `<CartDrawer />` in
 * Base) renders into every `[data-cart-*]` hook on the page, so the drawer and
 * this page stay in sync from one source of truth. The markup below ships a
 * skeleton line list and both empty/filled states; cart.ts toggles them.
 */
import Base from "../layouts/Base.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import TrustIcons from "../components/TrustIcons.astro"
import EmptyState from "../components/EmptyState.astro"
import Breadcrumb from "../components/Breadcrumb.astro"
import { SITE } from "../lib/site"
import { breadcrumbJsonLd } from "../lib/seo"
import { pageLocale, useTranslations } from "../lib/i18n"

const t = useTranslations(pageLocale(Astro))
const crumbs = [{ name: t("nav.home"), href: "/" }, { name: t("cart.title") }]
---

<Base
  title={t("cart.title")}
  description="Review your Toonhub figures, apply the Buy 1 get the 2nd 50% off offer and check out with free worldwide shipping."
  canonical="/cart"
  robots="noindex,follow"
  jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}
  overlays={{ quickView: false }}
>
  <Header />

  <main id="MainContent" class="page-width cart-page">
    <Breadcrumb items={crumbs} />

    <header class="page-head">
      <h1 class="section-heading">{t("cart.title")}</h1>
      <p class="page-head__meta">
        <span data-cart-count hidden>0</span>
        <a href="/collections" class="link-btn">{t("cart.continueShopping")}</a>
      </p>
    </header>

    <p class="offer-note">{SITE.offer}</p>

    <div data-cart-empty hidden>
      <EmptyState
        icon="cart"
        title={t("cart.emptyTitle")}
        description={t("cart.emptyBody")}
        action={{ label: t("cart.continueShopping"), href: "/collections" }}
        secondaryAction={{ label: t("account.signIn"), href: "/account", variant: "outline" }}
      />
    </div>

    <div class="cart-layout" data-cart-filled hidden>
      <section aria-label={t("cart.items")}>
        {/* cart.ts injects `<li>` skeletons while the cart loads. */}
        <ul class="cart-line-list" data-cart-lines></ul>
        <noscript>
          <EmptyState
            icon="alert"
            title={t("cart.jsTitle")}
            description={t("cart.jsBody")}
          />
        </noscript>
      </section>

      <aside class="cart-summary" data-cart-summary aria-labelledby="cartSummaryHeading">
        <h2 class="cart-summary__heading" id="cartSummaryHeading">{t("cart.summary")}</h2>

        <dl class="cart-totals">
          <div class="cart-totals__row">
            <dt>{t("cart.subtotal")}</dt>
            <dd data-cart-subtotal>$0.00</dd>
          </div>
          <div class="cart-totals__row cart-totals__row--discount" data-cart-discount-row hidden>
            <dt>{t("cart.discountLabel")}</dt>
            <dd data-cart-discount>−$0.00</dd>
          </div>
          <div class="cart-totals__row">
            <dt>{t("cart.shipping")}</dt>
            <dd>{t("cart.freeShipping")}</dd>
          </div>
          <div class="cart-totals__row cart-totals__row--primary">
            <dt>{t("cart.total")}</dt>
            <dd data-cart-total>$0.00</dd>
          </div>
        </dl>

        <p class="cart-summary__note">{t("cart.taxesNote")}</p>
        <p class="offer-note" data-cart-nudge hidden></p>

        {/* Consent gate: checkout stays inert until the shopper opts in. */}
        <label class="cart-agree" for="cartAgree">
          <input type="checkbox" id="cartAgree" name="agree" data-cart-agree aria-describedby="cartAgreeHint" />
          <span>
            {t("cart.agreePrefix")}
            <a href="/policies/terms-of-service">{t("footer.terms")}</a>
            {t("cart.agreeAnd")}
            <a href="/policies/privacy-policy">{t("footer.privacy")}</a>
            {t("cart.agreeSuffix")}
          </span>
        </label>
        <p class="cart-agree__hint" id="cartAgreeHint" data-cart-agree-hint role="status" hidden>
          {t("cart.agreeHint")}
        </p>

        <a class="btn btn-solid btn-block" href="/checkout" data-cart-checkout>
          {t("cart.checkout")}
        </a>
        <a class="btn btn-outline btn-block cart-summary__continue" href="/collections">
          {t("cart.continueShopping")}
        </a>

        <p class="cart-summary__legal">
          {t("cart.legalPrefix")}
          <a href="/policies/terms-of-service">{t("footer.terms")}</a>
          {t("cart.legalAnd")}
          <a href="/policies/privacy-policy">{t("footer.privacy")}</a>.
        </p>

        <TrustIcons variant="list" />
      </aside>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .cart-page { padding: 24px 0 64px; min-height: 50vh; }
  .page-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 12px 0 16px; }
  .page-head__meta { display: flex; align-items: center; gap: 12px; font-size: 0.85rem; color: var(--text-muted); }
  .offer-note {
    border: 1px solid var(--color-border);
    padding: 12px 14px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .cart-layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .cart-line-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .cart-summary {
    border: 1px solid var(--color-border);
    padding: 20px;
    position: sticky;
    top: 84px;
  }
  .cart-summary__heading {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 16px;
  }
  .cart-totals { margin: 0 0 12px; }
  .cart-totals dt { color: var(--text-muted); font-size: 0.85rem; }
  .cart-totals dd { margin: 0; font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .cart-summary__note { font-size: 0.72rem; color: var(--text-faint); }
  .cart-summary__legal { font-size: 0.72rem; color: var(--text-faint); text-align: center; margin-top: 12px; line-height: 1.5; }
  .cart-summary__legal a { text-decoration: underline; }
  .cart-agree {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 18px 0 12px;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.45;
    cursor: pointer;
  }
  .cart-agree input[type="checkbox"] { margin-top: 3px; width: 16px; height: 16px; flex: none; accent-color: #B5C771; }
  .cart-agree a { text-decoration: underline; }
  .cart-agree__hint {
    margin: 0 0 8px;
    font-size: 0.78rem;
    color: #f0b75c;
  }
  .cart-summary .btn-block + .btn-block { margin-top: 10px; }
  /* Gated checkout stays clickable so we can explain WHY it is disabled. */
  .cart-summary .btn.is-disabled { opacity: 0.55; cursor: not-allowed; filter: grayscale(0.25); }
  @media (max-width: 900px) {
    .cart-layout { grid-template-columns: minmax(0, 1fr); }
    .cart-summary { position: static; }
  }
</style>
