---
/**
 * "Shop All" — every browseable Medusa category as a tile.
 *
 * Empty-state contract: when the backend returns no categories the page says so
 * and names the likely cause (missing publishable key) instead of rendering an
 * empty grid. `catalog.ts` can still fill the grid from the browser if the
 * server-side request was the only one that failed.
 */
import Base from "../../layouts/Base.astro"
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import CollectionCard from "../../components/CollectionCard.astro"
import Breadcrumb from "../../components/Breadcrumb.astro"
import Skeleton from "../../components/Skeleton.astro"
import EmptyState from "../../components/EmptyState.astro"
import { getAllCategories } from "../../lib/medusa"
import { medusaConfig } from "../../lib/medusa-config"
import { shopCategories, categoryBlurb } from "../../lib/site"
import { categoryImage } from "../../lib/images"
import { breadcrumbJsonLd, collectionPageJsonLd } from "../../lib/seo"
import { pageLocale, useTranslations } from "../../lib/i18n"
import type { ProductCategory } from "../../types"

const t = useTranslations(pageLocale(Astro))

let categories: ProductCategory[] = []
try {
  categories = await getAllCategories()
} catch {
  categories = []
}

const series = shopCategories(categories)
const crumbs = [{ name: "Home", href: "/" }, { name: "Shop All" }]
const medusa = medusaConfig()
---

<Base
  title="Shop All"
  description={`Browse every anime figure collection at ${medusaConfig().isLocal ? "the Toonhub demo catalogue" : "Toonhub"} — ${series.length || "40"}+ series, worldwide shipping.`}
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site), collectionPageJsonLd(null, Astro.site)]}
  overlays={{ quickView: false }}
>
  <Header />

  <main id="MainContent" class="page-width shopby-section collections-index">
    <Breadcrumb items={crumbs} />

    <header class="page-head">
      <h1 class="section-heading">Shop All</h1>
      <p class="page-head__intro">
        Browse by series — each tile is a collection, not a single product.
      </p>
    </header>

    {series.length ? (
      <div class="shopby-grid" data-hydrate-cats>
        {series.map((category, index) => (
          <CollectionCard
            category={category}
            name={String(category.name || "")}
            handle={String(category.handle || "")}
            description={categoryBlurb(String(category.name || ""))}
            img={categoryImage(category)}
            count={(category.products || []).length}
            headingLevel={2}
            priority={index < 8}
          />
        ))}
      </div>
    ) : (
      <div data-hydrate-cats>
        <Skeleton variant="tile" count={12} layout="grid" label={t("a11y.loading")} />
        <noscript>
          <EmptyState
            icon="box"
            title={t("grid.emptyTitle")}
            description={`No collections came back from ${medusa.baseUrl}.${
              medusa.publishableKey
                ? ""
                : " Add MEDUSA_PUBLISHABLE_KEY (Admin → Settings → Publishable API Keys) and link it to a sales channel."
            }`}
            action={{ label: t("grid.browseAll"), href: "/", variant: "outline" }}
          />
        </noscript>
      </div>
    )}
  </main>

  <Footer />
</Base>

<script>
  import "../../scripts/catalog"
</script>

<style>
  .collections-index { padding-top: 40px; padding-bottom: 48px; }
  .page-head { margin-bottom: 28px; }
  .page-head__intro { margin-top: 8px; color: var(--text-muted); font-size: 0.9rem; max-width: 62ch; }
</style>
