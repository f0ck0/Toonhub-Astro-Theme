---
import "../../styles/checkout.css"
import { SITE } from "../../lib/site"
import TrustIcons from "../../components/TrustIcons.astro"
export const prerender = false
const order = Astro.url.searchParams.get("order") || ""
const email = Astro.url.searchParams.get("email") || ""
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Thank you — {SITE.name}</title>
  <link rel="stylesheet" href="/fonts/fonts.css" />
</head>
<body class="co-body">
  <main class="co-main" style="margin:0 auto;padding-top:64px;text-align:center;max-width:560px;">
    <a href="/" class="co-logo">{SITE.name}</a>
    <h1 class="co-h" style="margin-top:36px;font-size:1.6rem;">Thank you for your order</h1>
    <p style="color:#bbb;margin-top:12px;line-height:1.55;">
      {order ? `Order ${order} is confirmed.` : "Your order is confirmed."}
      {email ? ` A receipt will be sent to ${email}.` : ""}
    </p>
    <div class="co-offer" style="text-align:left;margin-top:22px;">
      <strong>What happens next</strong><br />
      We pack in 2–3 business days · Free worldwide shipping with tracking · 30-day returns
    </div>
    <TrustIcons gift />
    <a href="/collections" class="co-btn pay" style="max-width:320px;margin:28px auto 0;">Continue shopping</a>
    <p class="co-lock"><a href="/track-order">Track this order</a> · <a href="/">Back to home</a></p>
  </main>
  <script>
    try {
      localStorage.removeItem("cartId")
      localStorage.removeItem("toonhub_local_cart")
    } catch {}
  </script>
</body>
</html>
