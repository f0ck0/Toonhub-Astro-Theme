---
import Base from "../layouts/Base.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import ProductCard from "../components/ProductCard.astro"
import { searchProducts } from "../lib/medusa"

const url = new URL(Astro.request.url)
const q = url.searchParams.get("q") || ""
let products: any[] = []
let totalCount = 0

if (q) {
  try {
    const result = await searchProducts(q, 48)
    products = result.products
    totalCount = result.count
  } catch (e) { console.error(e) }
}
---
<Base title={q ? `Search: ${q} — TOONHUB` : "Search — TOONHUB"}>
  <Header />
  <main id="MainContent" class="page-width" style="padding:48px 0;">
    <h1 style="font-size:2rem;margin-bottom:24px;">Search</h1>
    <form method="get" style="display:flex;gap:12px;margin-bottom:32px;">
      <input class="field" type="search" name="q" value={q} placeholder="Search anime figures..." style="flex:1;" />
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
    {q && <p style="font-size:0.85rem;color:#888;margin-bottom:24px;">{totalCount} results for “{q}”</p>}
    {products.length > 0 ? (
      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    ) : q ? (
      <div style="text-align:center;padding:80px 0;">
        <h3 style="font-size:1.25rem;">No results found</h3>
        <a href="/collections/all" class="btn btn-outline" style="margin-top:20px;">Continue shopping</a>
      </div>
    ) : (
      <div style="text-align:center;padding:80px 0;color:#888;">
        <h3 style="font-size:1.25rem;color:#fff;">Search for anime figures</h3>
      </div>
    )}
  </main>
  <Footer />
</Base>
