---
import Base from "../layouts/Base.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import ProductCard from "../components/ProductCard.astro"
import { searchProducts } from "../lib/medusa"

const url = new URL(Astro.request.url)
const q = url.searchParams.get("q") || ""
let products: any[] = []
let totalCount = 0

if (q) {
    try {
        const result = await searchProducts(q, 48)
        products = result.products
        totalCount = result.count
    } catch (e) { console.error(e) }
}
---
<Base>
    <Header />
    <main class="page-width" style="padding:48px 0;">
        <h1 style="font-size:2rem;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:24px;">Search</h1>
        <div style="margin-bottom:32px;">
            <form method="get" style="display:flex;gap:12px;">
                <input type="text" name="q" value={q} placeholder="Search anime figures..." style="flex:1;padding:12px 20px;border:1px solid var(--color-border);border-radius:0.3rem;font-size:0.9rem;background:#000;color:#fff;outline:none;font-family:inherit;" />
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>

        {q && (
            <p style="font-size:0.85rem;color:#888;margin-bottom:24px;">{totalCount} results for "{q}"</p>
        )}

        {products.length > 0 ? (
            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;" class="search-grid">
                {products.map((product) => <ProductCard product={product} />)}
            </div>
        ) : q ? (
            <div style="text-align:center;padding:80px 0;">
                <div style="font-size:48px;">🔍</div>
                <h3 style="font-size:1.25rem;font-weight:700;color:#fff;margin-top:16px;">No results found</h3>
            </div>
        ) : (
            <div style="text-align:center;padding:80px 0;">
                <div style="font-size:48px;">🔍</div>
                <h3 style="font-size:1.25rem;font-weight:700;color:#fff;margin-top:16px;">Search for anime figures</h3>
            </div>
        )}
    </main>
    <Footer />
</Base>

<style>
    @media (max-width: 990px) { .search-grid { grid-template-columns: repeat(2, 1fr) !important; } }
</style>