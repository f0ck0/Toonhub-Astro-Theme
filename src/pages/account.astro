---
import Base from "../layouts/Base.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
---
<Base>
    <Header />
    <main class="page-width" style="display:flex;justify-content:center;padding:48px 0 80px;">
        <div style="width:100%;max-width:460px;">
            <h1 class="account-title" style="font-size:1.5rem;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:0.04em;line-height:1.3;margin-bottom:12px;">YOUR ACCOUNT FOR EVERYTHING TOONHUB</h1>
            <p class="account-sub" style="font-size:0.85rem;color:#888;margin-bottom:24px;">Sign in to access your orders, wishlist and member benefits.</p>

            <!-- Login form -->
            <form id="loginForm" class="account-form" onsubmit="return false;" style="display:flex;flex-direction:column;gap:16px;">
                <input type="email" id="loginEmail" class="account-input" placeholder="Email address" required autocomplete="email" />
                <input type="password" id="loginPassword" class="account-input" placeholder="Password" required autocomplete="current-password" />
                <div class="account-row" style="display:flex;justify-content:space-between;align-items:center;">
                    <label style="display:flex;align-items:center;gap:8px;font-size:0.82rem;color:#999;cursor:pointer;">
                        <input type="checkbox" id="rememberMe" style="width:16px;height:16px;accent-color:#fff;" /> Keep me signed in
                    </label>
                    <a href="#" style="font-size:0.82rem;color:#999;text-decoration:underline;">Forgot Password?</a>
                </div>
                <div id="loginError" style="display:none;font-size:0.82rem;color:#e53935;margin-top:8px;"></div>
                <button type="submit" id="loginBtn" class="btn btn-primary" style="width:100%;justify-content:center;border:none;cursor:pointer;">Continue</button>
            </form>

            <!-- Divider -->
            <div style="display:flex;align-items:center;gap:16px;margin:24px 0;color:#666;font-size:0.82rem;">
                <span style="flex:1;height:1px;background:var(--color-border);"></span><span>or</span><span style="flex:1;height:1px;background:var(--color-border);"></span>
            </div>

            <!-- Social login (placeholder) -->
            <div style="display:flex;flex-direction:column;gap:12px;">
                <button class="social-btn" id="googleBtn" style="cursor:pointer;">
                    <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                    <span>Continue with Google</span>
                </button>
                <button class="social-btn" id="appleBtn" style="cursor:pointer;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M16.36 12.76c0-2.28 1.86-3.37 1.94-3.43-1.06-1.55-2.7-1.76-3.29-1.79-1.4-.14-2.73.82-3.44.82-.71 0-1.81-.8-2.97-.78-1.53.02-2.94.89-3.72 2.26-1.59 2.76-.41 6.84 1.14 9.08.76 1.1 1.66 2.33 2.84 2.29 1.14-.05 1.57-.74 2.95-.74 1.38 0 1.76.74 2.97.72 1.23-.02 2.01-1.12 2.76-2.22.87-1.27 1.23-2.5 1.25-2.57-.03-.01-2.41-.92-2.43-3.66z"/><path d="M14.06 4.8c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.68-1.09 1.76-.95 2.8 1.01.08 2.04-.51 2.67-1.28z"/></svg>
                    <span>Continue with Apple</span>
                </button>
            </div>

            <!-- Register link -->
            <p style="font-size:0.82rem;color:#999;text-align:center;margin-top:24px;">Not a Member? <a href="/account?mode=register" style="text-decoration:underline;color:#fff;">Join Us</a></p>
            <p style="font-size:0.72rem;color:#666;text-align:center;margin-top:16px;line-height:18px;">
                By signing in, you agree to Toonhub's Terms of Use and Privacy Policy.
            </p>
        </div>
    </main>
    <Footer />
</Base>

<script>
    const loginForm = document.getElementById('loginForm')
    const loginBtn = document.getElementById('loginBtn')
    const loginError = document.getElementById('loginError')

    // Register mode (simple title switch)
    const params = new URLSearchParams(location.search)
    const mode = params.get('mode') || 'login'
    if (mode === 'register') {
        document.querySelector('.account-title').innerText = 'BECOME A MEMBER'
        document.querySelector('.account-sub').innerText = 'Create your Toonhub account and get access to exclusive figures.'
        loginBtn.innerText = 'Create Account'
    }

    loginForm.onsubmit = async () => {
        const email = document.getElementById('loginEmail').value
        const password = document.getElementById('loginPassword').value
        loginError.style.display = 'none'
        loginBtn.disabled = true
        loginBtn.innerText = 'Loading...'
        try {
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password, mode }),
            })
            const data = await res.json()
            if (res.ok && data.token) {
                localStorage.setItem('toonhub_token', data.token)
                localStorage.setItem('toonhub_email', email)
                window.location.href = '/'
            } else {
                loginError.innerText = data.error || 'Invalid email or password'
                loginError.style.display = 'block'
            }
        } catch (e) {
            loginError.innerText = 'Network error, please try again'
            loginError.style.display = 'block'
        }
        loginBtn.disabled = false
        loginBtn.innerText = mode === 'register' ? 'Create Account' : 'Continue'
    }

    // Social login placeholder
    const social = (name) => {
        document.getElementById('loginError').innerText = name + ' is not configured yet. Use email to sign in.'
        document.getElementById('loginError').style.display = 'block'
    }
    document.getElementById('googleBtn').onclick = () => social('Google')
    document.getElementById('appleBtn').onclick = () => social('Apple')
</script>

<style>
    .account-form { display: flex; flex-direction: column; gap: 16px; }
    .account-input {
        width: 100%; height: 44px; padding: 0 14px; border: 1px solid var(--color-border); border-radius: 0.3rem;
        font-size: 0.9rem; font-family: inherit; color: #fff; background: #000; outline: none; transition: border-color 200ms ease;
        box-sizing: border-box;
    }
    .account-input:focus { border-color: #666; }
    .account-input::placeholder { color: #666; }
    .social-btn {
        display: flex; align-items: center; justify-content: center; gap: 10px;
        width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: 0.3rem;
        background: transparent; font-size: 0.9rem; font-weight: 700; color: #fff; font-family: inherit;
        transition: all 200ms ease;
    }
    .social-btn:hover { background: #111; border-color: #666; }
</style>