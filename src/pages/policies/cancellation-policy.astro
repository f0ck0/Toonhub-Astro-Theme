---
import PolicyLayout from "../../components/PolicyLayout.astro"
import { SITE } from "../../lib/site"
import { pageLocale, useTranslations } from "../../lib/i18n"

const t = useTranslations(pageLocale(Astro))
---
<PolicyLayout title={t("policy.cancel.title")} description={t("policy.cancel.metaDesc")}>
  <p>{t("policy.cancel.lead")}</p>
  <h2>{t("policy.cancel.howH")}</h2>
  <p>{t("policy.cancel.howP", { email: SITE.email })}</p>
  <h2>{t("policy.cancel.afterH")}</h2>
  <p>
    {t("policy.cancel.afterP1")}{" "}<a href="/policies/refund-policy">{t("policy.link.refund")}</a>{" "}{t("policy.cancel.afterP2")}
  </p>
  <h2>{t("policy.cancel.customH")}</h2>
  <p>{t("policy.cancel.customP")}</p>
</PolicyLayout>
